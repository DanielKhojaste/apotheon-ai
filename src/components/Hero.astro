---
const sparks = [
  { class: "left-[12%] top-[22%] size-1", delay: "0s" },
  { class: "left-[28%] top-[14%] size-[3px]", delay: "0.8s" },
  { class: "right-[18%] top-[18%] size-1.5", delay: "1.4s" },
  { class: "right-[8%] top-[42%] size-[3px]", delay: "2.1s" },
  { class: "right-[22%] bottom-[28%] size-1", delay: "0.4s" },
  { class: "left-[8%] bottom-[36%] size-[3px]", delay: "1.8s" },
  { class: "left-[42%] top-[10%] size-1", delay: "2.6s" },
];
---

<section class="relative flex min-h-0 flex-1 flex-col overflow-hidden" aria-labelledby="hero-heading">
  <div class="container-page grid min-h-0 flex-1 grid-rows-[auto_minmax(0,1fr)] items-center gap-4 py-3 sm:gap-6 lg:grid-cols-2 lg:grid-rows-1 lg:gap-8 lg:py-2">
    <div class="relative z-10 max-w-xl lg:max-w-none lg:self-center lg:pr-6">
      <h1
        id="hero-heading"
        class="font-serif text-4xl leading-[1.08] font-medium tracking-tight text-cream sm:text-5xl lg:text-[3.75rem] xl:text-[4.35rem]"
      >
        Ascend to the divine.
      </h1>
      <p class="mt-4 max-w-md font-sans text-sm leading-relaxed text-mist sm:mt-6 sm:text-base lg:text-lg">
        Enterprise AI security, raised to a higher standard of visibility, control, and trust.
      </p>
      <a class="btn-gold btn-gold-lg mt-6 sm:mt-8" href="#platform">Explore Platform</a>
    </div>

    <div class="relative flex h-full min-h-0 w-full items-center justify-center overflow-hidden lg:justify-end">
      <div class="hero-glow"></div>

      {sparks.map((spark) => (
        <span class:list={["spark", spark.class]} style={`animation-delay: ${spark.delay}`}></span>
      ))}

      <div class="relative mx-auto flex h-full w-full max-w-xs items-center justify-center sm:max-w-sm lg:mx-0 lg:max-w-none lg:justify-end">
        <img
          src="/helmet1-transparent.png"
          alt="Weathered bronze Spartan helmet"
          width="1006"
          height="1523"
          class="mx-auto h-full w-auto max-w-full object-contain object-center drop-shadow-[0_20px_60px_rgb(0_0_0_/_0.65)]"
        />

        <svg
          class="pointer-events-none absolute inset-0 z-20 h-full w-full opacity-70 mix-blend-screen"
          viewBox="0 0 400 560"
          fill="none"
          aria-hidden="true"
        >
          <g stroke="#d8bc82" stroke-opacity="0.55" stroke-width="0.7">
            <line x1="168" y1="92" x2="214" y2="128"></line>
            <line x1="214" y1="128" x2="262" y2="118"></line>
            <line x1="214" y1="128" x2="236" y2="188"></line>
            <line x1="262" y1="118" x2="298" y2="162"></line>
            <line x1="236" y1="188" x2="298" y2="162"></line>
            <line x1="236" y1="188" x2="198" y2="242"></line>
            <line x1="198" y1="242" x2="148" y2="228"></line>
            <line x1="148" y1="228" x2="168" y2="92"></line>
            <line x1="198" y1="242" x2="228" y2="312"></line>
            <line x1="228" y1="312" x2="286" y2="286"></line>
            <line x1="286" y1="286" x2="298" y2="162"></line>
            <line x1="228" y1="312" x2="176" y2="368"></line>
            <line x1="176" y1="368" x2="132" y2="318"></line>
            <line x1="132" y1="318" x2="148" y2="228"></line>
            <line x1="176" y1="368" x2="210" y2="430"></line>
            <line x1="210" y1="430" x2="268" y2="402"></line>
            <line x1="268" y1="402" x2="286" y2="286"></line>
            <line x1="210" y1="430" x2="154" y2="456"></line>
          </g>
          <g fill="#e8d09a">
            <circle cx="168" cy="92" r="2.2"></circle>
            <circle cx="214" cy="128" r="2.8"></circle>
            <circle cx="262" cy="118" r="2"></circle>
            <circle cx="298" cy="162" r="2.4"></circle>
            <circle cx="236" cy="188" r="3.1"></circle>
            <circle cx="198" cy="242" r="2.6"></circle>
            <circle cx="148" cy="228" r="2.1"></circle>
            <circle cx="228" cy="312" r="2.9"></circle>
            <circle cx="286" cy="286" r="2.3"></circle>
            <circle cx="176" cy="368" r="2.5"></circle>
            <circle cx="132" cy="318" r="1.8"></circle>
            <circle cx="210" cy="430" r="2.7"></circle>
            <circle cx="268" cy="402" r="2"></circle>
            <circle cx="154" cy="456" r="1.9"></circle>
          </g>
        </svg>
      </div>
    </div>
  </div>

  <div class="container-page mt-auto shrink-0 pb-4 pt-2">
    <p class="section-kicker mb-3">Platform</p>
    <div class="h-px w-full bg-gold/45"></div>
  </div>
</section>
