---
const CX = 500;
const CY = 512;
const HELMET_RX = 256;
const HELMET_RY = 330;
const VIEW_W = 1000;
const VIEW_H = 1120;

type Node = {
  x: number;
  y: number;
  r: number;
  ring: number;
  spark: boolean;
  delay: string;
};

function seeded(i: number, k: number) {
  const s = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
  return s - Math.floor(s);
}

function fmt(n: number) {
  return Math.round(n * 10) / 10;
}

function inTitleGap(x: number, y: number) {
  return y > CY + HELMET_RY * 0.28 && Math.abs(x - CX) < 168 && y < CY + HELMET_RY * 1.42;
}

function insidePaddedHelmet(x: number, y: number, pad = 1.12) {
  const nx = (x - CX) / (HELMET_RX * pad);
  const ny = (y - CY) / (HELMET_RY * pad);
  return nx * nx + ny * ny < 1;
}

const rings = [
  { rx: HELMET_RX * 1.18, ry: HELMET_RY * 1.16, count: 18, size: 2.7, phase: 0.04, jitter: 0.055 },
  { rx: HELMET_RX * 1.44, ry: HELMET_RY * 1.4, count: 22, size: 2.3, phase: 0.17, jitter: 0.07 },
  { rx: HELMET_RX * 1.74, ry: HELMET_RY * 1.68, count: 26, size: 2.0, phase: 0.07, jitter: 0.075 },
  { rx: HELMET_RX * 2.08, ry: HELMET_RY * 1.98, count: 20, size: 1.7, phase: 0.23, jitter: 0.06 },
  { rx: HELMET_RX * 2.46, ry: HELMET_RY * 2.28, count: 14, size: 1.45, phase: 0.11, jitter: 0.05 },
];

const nodes: Node[] = [];

for (const [ri, ring] of rings.entries()) {
  const half = ring.count / 2;
  for (let i = 0; i <= half; i++) {
    const t = -Math.PI / 2 + (i / half) * Math.PI + ring.phase;
    const jr = 1 + (seeded(i, ri + 1) - 0.5) * ring.jitter;
    const jt = (seeded(i, ri + 7) - 0.5) * 0.065;
    const x = CX + ring.rx * Math.cos(t + jt) * jr;
    const y = CY + ring.ry * Math.sin(t + jt) * jr;

    if (x < CX - 0.6) continue;
    if (insidePaddedHelmet(x, y, 1.14)) continue;
    if (inTitleGap(x, y)) continue;
    if (x < 18 || x > VIEW_W - 18 || y < 18 || y > VIEW_H - 18) continue;

    const node: Node = {
      x,
      y,
      r: ring.size * (0.84 + seeded(i, ri + 3) * 0.36),
      ring: ri,
      spark: seeded(i, ri + 11) > 0.7,
      delay: `${(seeded(i, ri + 15) * 3.6).toFixed(2)}s`,
    };
    nodes.push(node);
    if (x > CX + 2.5) {
      nodes.push({ ...node, x: 2 * CX - x });
    }
  }
}

const outlierScales = [
  { a: -1.12, s: 2.58, r: 1.5 },
  { a: -0.62, s: 2.7, r: 1.7 },
  { a: 0.38, s: 2.62, r: 1.45 },
  { a: 0.92, s: 2.5, r: 1.35 },
];

for (const [oi, out] of outlierScales.entries()) {
  const x = CX + HELMET_RX * out.s * Math.cos(out.a);
  const y = CY + HELMET_RY * out.s * Math.sin(out.a);
  if (inTitleGap(x, y) || x > VIEW_W - 24 || y > VIEW_H - 24 || y < 24) continue;
  const node: Node = {
    x,
    y,
    r: out.r,
    ring: 5,
    spark: true,
    delay: `${(0.4 + oi * 0.7).toFixed(2)}s`,
  };
  nodes.push(node);
  nodes.push({ ...node, x: 2 * CX - x });
}

function dist(a: Node, b: Node) {
  return Math.hypot(a.x - b.x, a.y - b.y);
}

function crossesHelmet(a: Node, b: Node) {
  const steps = 4;
  for (let s = 1; s < steps; s++) {
    const t = s / steps;
    if (insidePaddedHelmet(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, 1.1)) return true;
  }
  return false;
}

const edgeKeys = new Set<string>();
const edges: Array<[number, number]> = [];

function addEdge(i: number, j: number) {
  if (i === j) return;
  const a = Math.min(i, j);
  const b = Math.max(i, j);
  const key = `${a},${b}`;
  if (edgeKeys.has(key)) return;
  if (crossesHelmet(nodes[a], nodes[b])) return;
  edgeKeys.add(key);
  edges.push([a, b]);
}

for (let i = 0; i < nodes.length; i++) {
  const maxD = 78 + nodes[i].ring * 26;
  const candidates = nodes
    .map((n, j) => ({ j, d: dist(nodes[i], n), ring: n.ring }))
    .filter((c) => c.j !== i)
    .sort((a, b) => a.d - b.d);

  for (const c of candidates.slice(0, 2)) {
    if (c.d < maxD) addEdge(i, c.j);
  }

  const next = candidates.find((c) => c.ring === nodes[i].ring + 1 && c.d < maxD + 36);
  if (next) addEdge(i, next.j);
}
---

<section class="relative flex min-h-0 flex-1 flex-col overflow-hidden" aria-labelledby="hero-heading">
  <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pb-8 pt-1 sm:px-8">
    <div class="hero-figure relative">
      <div class="hero-glow"></div>

      <svg
        class="hero-constellation"
        viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <mask id="constellation-hole" maskUnits="userSpaceOnUse">
            <rect width={VIEW_W} height={VIEW_H} fill="white"></rect>
            <ellipse cx={CX} cy={CY} rx={HELMET_RX * 1.13} ry={HELMET_RY * 1.11} fill="black"></ellipse>
          </mask>
        </defs>
        <g mask="url(#constellation-hole)">
          <g stroke="#d8bc82" stroke-opacity="0.55" stroke-width="1.05">
            {edges.map(([a, b]) => (
              <line x1={fmt(nodes[a].x)} y1={fmt(nodes[a].y)} x2={fmt(nodes[b].x)} y2={fmt(nodes[b].y)}></line>
            ))}
          </g>
          <g fill="#e8d09a">
            {nodes.map((node) =>
              node.spark ? (
                <circle
                  class="spark-node"
                  cx={fmt(node.x)}
                  cy={fmt(node.y)}
                  r={fmt(node.r)}
                  style={`animation-delay: ${node.delay}`}
                ></circle>
              ) : (
                <circle cx={fmt(node.x)} cy={fmt(node.y)} r={fmt(node.r)}></circle>
              )
            )}
          </g>
        </g>
      </svg>

      <img
        src="/spartan-helmet-front-hero-snug.png"
        alt="Weathered bronze Spartan helmet"
        width="2053"
        height="3790"
        fetchpriority="high"
        class="relative z-[2] h-[min(62svh,36.5rem)] w-auto max-w-[min(72vw,22rem)] object-contain object-center drop-shadow-[0_24px_60px_rgb(0_0_0_/_0.55)] sm:max-w-[min(58vw,26rem)]"
      />

      <h1
        id="hero-heading"
        class="pointer-events-none absolute left-1/2 top-[36%] z-[3] w-screen -translate-x-1/2 text-center sm:top-[38%]"
      >
        <span class="sr-only">Ascend to the divine.</span>
        <span aria-hidden="true" class="flex flex-col items-center">
          <span class="hero-word-lg hero-metal">
            <svg class="hero-lambda" viewBox="0 0 78 82" fill="currentColor">
              <path d="M39 2.4 20.2 79.2H8.1L34.6 2.4H39Z"></path>
              <path d="M39 2.4h4.8L69.9 79.2H57.6L39 2.4Z"></path>
            </svg>SCEND
          </span>
          <span class="hero-word-sm hero-metal">TO THE</span>
          <span class="hero-word-lg hero-metal">DIVINE</span>
        </span>
      </h1>
    </div>
  </div>
</section>
