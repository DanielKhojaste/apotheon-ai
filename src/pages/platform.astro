---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ApotheonAI | Platform">
	<article class="container-page py-16">
		<div class="max-w-3xl">
			<p class="section-kicker mb-4">Platform</p>
			<h1
				class="font-serif text-4xl font-medium tracking-tight text-cream sm:text-5xl"
			>
				The ApotheonAI Platform
			</h1>
			<p class="mt-6 font-sans text-base leading-relaxed text-mist sm:text-lg">
				Bring AI activity across tools, teams, and workflows into a single
				operational view. This page is a placeholder for the full platform
				story, including visibility, threat detection, prompt protection, and
				governance.
			</p>
		</div>
	</article>
</BaseLayout>
