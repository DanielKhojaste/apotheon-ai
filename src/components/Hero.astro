<section class="hero-section" aria-labelledby="hero-heading">
  <div class="hero-stage">
    <svg class="hero-constellation" aria-hidden="true">
      <defs>
        <filter
          id="constellation-line-glow"
          filterUnits="userSpaceOnUse"
          x="-8%"
          y="-8%"
          width="116%"
          height="116%"
          color-interpolation-filters="sRGB"
        >
          <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
        </filter>
        <mask id="constellation-hole" maskUnits="userSpaceOnUse">
          <rect width="100%" height="100%" fill="white"></rect>
          <ellipse cx="50%" cy="34%" rx="13.2%" ry="39%" fill="black"></ellipse>
        </mask>
      </defs>
      <g mask="url(#constellation-hole)">
        <g class="hero-constellation-line-glow" filter="url(#constellation-line-glow)">
          {lines.map((line) => (
            <line x1={pct(line.x1)} y1={pct(line.y1)} x2={pct(line.x2)} y2={pct(line.y2)}></line>
          ))}
        </g>
        <g class="hero-constellation-lines">
          {lines.map((line) => (
            <line x1={pct(line.x1)} y1={pct(line.y1)} x2={pct(line.x2)} y2={pct(line.y2)}></line>
          ))}
        </g>
        <g class="hero-constellation-stars">
          {stars.map((star) => (
            <circle
              class:list={[star.spark && "spark-node"]}
              cx={pct(star.x)}
              cy={pct(star.y)}
              r={star.r}
              style={star.spark ? `animation-delay: ${star.delay}` : undefined}
            ></circle>
          ))}
        </g>
      </g>
    </svg>

    <div class="hero-glow"></div>

    <div class="hero-cluster">
      <img
        class="hero-helmet"
        src="/spartan-helmet-front-hero-snug.png"
        alt="Weathered bronze Spartan helmet"
        width="2053"
        height="3790"
        fetchpriority="high"
      />

      <h1 id="hero-heading" class="hero-title">
        <span class="sr-only">Ascend to the divine.</span>
        <span aria-hidden="true" class="hero-title-stack">
          <span class="hero-word-ascend hero-metal">
            <svg class="hero-lambda" viewBox="0 0 280 272" fill="currentColor">
              <path d="M140 6 58 262H18L126 6H140Z"></path>
              <path d="M140 6H154L262 262H222L140 6Z"></path>
            </svg>SCEND
          </span>
          <span class="hero-word-mid hero-metal">TO THE</span>
          <span class="hero-word-divine hero-metal">DIVINE</span>
        </span>
      </h1>
    </div>
  </div>
</section>
