---
const links = [
	{ href: "/platform", label: "Platform" },
	{ href: "/capabilities", label: "Solutions" },
	{ href: "/insights", label: "Insights" },
	{ href: "/about", label: "About" },
	{ href: "/#contact", label: "Contact" },
];
---

<footer class="border-t border-gold/15">
	<div class="container-page py-16 sm:py-20">
		<p class="font-serif text-2xl font-medium tracking-tight text-cream">
			ApotheonAI
		</p>
		<p class="mt-3 font-sans text-sm text-mist sm:text-base">
			Elevate AI. Secure What Comes Next.
		</p>

		<nav class="mt-8 flex flex-wrap gap-x-8 gap-y-3" aria-label="Footer">
			{
				links.map((link) => (
					<a class="nav-link" href={link.href}>
						{link.label}
					</a>
				))
			}
		</nav>

		<p class="mt-12 max-w-2xl font-sans text-xs leading-relaxed text-mist/70">
			ApotheonAI is a fictional company created as a portfolio and learning
			project.
		</p>
	</div>
</footer>
