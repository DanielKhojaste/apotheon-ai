---
const links = [
	{ href: "/platform", label: "Platform" },
	{ href: "/about", label: "About" },
	{ href: "/blog", label: "Blog" },
	{ href: "/contact", label: "Contact" },
];
---

<header class="site-header is-visible" data-site-header>
	<nav
		class="site-header-bar container-page relative flex items-center justify-between py-4"
		aria-label="Primary"
	>
		<a href="/" class="group flex items-center" aria-label="ApotheonAI home">
			<span
				class="logo-mark h-9 w-5 bg-cream transition-colors duration-200 sm:h-10 sm:w-[1.4rem] group-hover:bg-gold"
				aria-hidden="true"></span>
		</a>

		<button
			type="button"
			class="nav-toggle flex items-center justify-center text-cream transition-colors duration-200 hover:text-gold"
			id="hs-header-overlay"
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls="hs-header-overlay-nav"
			aria-label="Open navigation"
			data-hs-overlay="#hs-header-overlay-nav"
		>
			<svg
				class="nav-burger"
				viewBox="0 0 100 100"
				aria-hidden="true"
				focusable="false"
			>
				<path data-nav-line="top" d="M 0 20 L 100 20"></path>
				<path data-nav-line="middle" d="M 25 50 L 100 50"></path>
				<path data-nav-line="bottom" d="M 0 80 L 100 80"></path>
			</svg>
		</button>
	</nav>

	<div
		id="hs-header-overlay-nav"
		class="hs-overlay pointer-events-auto hidden fixed inset-0 z-40 flex min-h-svh flex-col items-center justify-center bg-void/94 px-6 pb-16 pt-24 [--close-when-click-inside:true] [--overlay-backdrop:false]"
		role="dialog"
		tabindex="-1"
		aria-label="Site navigation"
	>
		{
			links.map((link) => (
				<a class="header-overlay-link" href={link.href}>
					{link.label}
				</a>
			))
		}
	</div>
</header>

<style>
	.header-overlay-link {
		display: flex;
		width: min(100%, 34rem);
		min-height: 5rem;
		align-items: center;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0 1rem;
		color: rgba(243, 235, 221, 0.9);
		font-family: var(--font-serif);
		font-size: 1.5rem;
		letter-spacing: 0.025em;
		transition:
			border-top-color 220ms ease,
			color 200ms ease,
			padding-left 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.header-overlay-link:last-child {
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.header-overlay-link:hover {
		border-top-color: rgba(201, 165, 106, 0.52);
		padding-left: 1.4rem;
		color: var(--color-gold-bright);
	}

	.header-overlay-link:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 4px;
	}

	@media (min-width: 640px) {
		.header-overlay-link {
			min-height: 5.5rem;
			padding-right: 1.25rem;
			padding-left: 1.25rem;
			font-size: 1.875rem;
		}

		.header-overlay-link:hover {
			padding-left: 1.7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.header-overlay-link {
			transition: none;
		}
	}
</style>

<script>
	import "../scripts/header.ts";
</script>
