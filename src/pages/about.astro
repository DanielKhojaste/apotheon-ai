---
import { Image } from "astro:assets";
import danielStatue from "../assets/images/daniel-statue.png";
import BaseLayout from "../layouts/BaseLayout.astro";

const skillGroups = [
	{
		title: "Frontend",
		skills: [
			"Astro",
			"React",
			"Next.js",
			"TypeScript",
			"Tailwind CSS",
			"Preline",
			"GSAP",
			"D3.js",
		],
	},
	{
		title: "Backend & Data",
		skills: [
			"Node.js",
			"Express.js",
			"NestJS",
			"REST APIs",
			"MySQL",
			"MariaDB",
			"Sanity",
			"GROQ",
		],
	},
	{
		title: "Testing & Delivery",
		skills: ["Playwright", "Postman", "Lighthouse", "Git", "Vercel", "Docker"],
	},
	{
		title: "Languages",
		skills: ["JavaScript", "TypeScript", "Python", "Java", "C#", "Rust", "PHP"],
	},
];

const objectives = [
	{
		number: "01",
		title: "Build for the real web",
		body: "Build a public-facing website with responsive design, accessibility, performance, and clear content treated as core requirements from the start.",
	},
	{
		number: "02",
		title: "Learn by shipping",
		body: "Use Astro in a real project and make practical decisions about when TypeScript, React, Preline, and client-side JavaScript are actually needed.",
	},
	{
		number: "03",
		title: "Make content maintainable",
		body: "Use Sanity to move the blog beyond hard-coded pages so new posts can be published and updated without editing the Astro source.",
	},
];
---

<BaseLayout title="About | ApotheonAI">
	<main>
		<!-- Hero -->
		<section class="relative overflow-hidden border-b border-white/10">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_76%_36%,rgba(197,157,86,0.12),transparent_31%)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="container-page relative grid min-h-[78vh] items-center gap-14 py-24 sm:py-28 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 lg:py-32"
			>
				<div class="relative z-10 max-w-3xl">
					<p class="section-kicker">About the Project</p>

					<h1
						class="mt-6 max-w-3xl font-serif text-4xl font-medium leading-[0.95] tracking-[-0.035em] text-cream sm:text-5xl lg:text-6xl xl:text-7xl"
					>
						A fictional company.
						<span class="block text-gold">A real development project.</span>
					</h1>

					<p
						class="mt-8 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						ApotheonAI is a fictional AI-security brand I created as a portfolio
						project to design and build a polished, content-driven website with
						a modern frontend stack.
					</p>
				</div>

				<div class="relative mx-auto w-full max-w-[27rem] self-end lg:ml-auto">
					<div
						class="pointer-events-none absolute bottom-[8%] left-1/2 h-[42%] w-[72%] -translate-x-1/2 rounded-full bg-[#c59d56]/10 blur-3xl"
						aria-hidden="true"
					>
					</div>

					<Image
						src={danielStatue}
						alt="A stylized Greek-statue portrait of the developer behind ApotheonAI"
						loading="eager"
						fetchpriority="high"
						draggable={false}
						class="noselect relative z-10 mx-auto block h-auto w-full max-w-[27rem] object-contain"
					/>

					<div
						class="absolute inset-x-[10%] bottom-3 z-20 border-t border-[#c59d56]/30 pt-3 text-center"
					>
						<p
							class="font-sans text-sm font-[100] uppercase tracking-[0.2em] text-cream/85 [text-shadow:0_1px_3px_rgba(0,0,0,0.5)] sm:text-base"
						>
							Daniel Khojaste
						</p>
						<p
							class="mt-1 font-sans text-[0.68rem] uppercase tracking-[0.24em] text-mist"
						>
							The developer behind ApotheonAI
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- About -->
		<section class="border-b border-white/10 py-28 sm:py-32 lg:py-36">
			<div class="container-page">
				<div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
					<div>
						<p class="section-kicker">About Me & the Project</p>
						<h2
							class="mt-5 max-w-xl font-serif text-4xl font-medium leading-tight tracking-tight text-cream sm:text-5xl"
						>
							A place to turn learning into something tangible.
						</h2>
					</div>

					<div>
						<div
							class="max-w-3xl space-y-6 font-sans text-base leading-relaxed text-mist sm:text-lg"
						>
							<p>
								I graduated from Algonquin College's Web Development & Internet
								Applications program, and I built ApotheonAI as a portfolio
								project to bring together the kind of work I enjoy: design,
								frontend development, content, testing, and deployment.
							</p>

							<p>
								The fictional brand gave me room to build something polished and
								cohesive while learning through a real project. My goal was to
								create a responsive, maintainable public website that I could
								take from the original design all the way through development,
								CMS integration, testing, and production.
							</p>
						</div>

						<div
							class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-7"
							aria-label="Daniel Khojaste's social profiles"
						>
							<p
								class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-mist"
							>
								Find me online
							</p>

							<a
								href="https://www.linkedin.com/in/aref-khojaste/"
								target="_blank"
								rel="noopener noreferrer"
								class="font-sans text-sm font-semibold text-[#c59d56] underline-offset-4 transition hover:text-cream hover:underline"
							>
								LinkedIn ↗
							</a>

							<a
								href="https://github.com/DanielKhojaste"
								target="_blank"
								rel="noopener noreferrer"
								class="font-sans text-sm font-semibold text-[#c59d56] underline-offset-4 transition hover:text-cream hover:underline"
							>
								GitHub ↗
							</a>
						</div>
					</div>
				</div>

				<div class="mt-20 border-t border-white/10 pt-14 sm:pt-16">
					<div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
						<div>
							<p class="section-kicker">Skills</p>
							<h3
								class="mt-5 max-w-lg font-serif text-3xl font-medium leading-tight tracking-tight text-cream sm:text-4xl"
							>
								Comfortable across the stack.
							</h3>
							<p
								class="mt-5 max-w-lg font-sans text-sm leading-relaxed text-mist sm:text-base"
							>
								My strongest focus is frontend development, but I also work with
								backend APIs, databases, testing, deployment, and several
								programming languages. That broader experience helps me
								understand how the pieces around the interface fit together.
							</p>
						</div>

						<div class="hs-accordion-group border-t border-white/10">
							{
								skillGroups.map((group, index) => {
									const headingId = `skill-heading-${index}`;
									const collapseId = `skill-collapse-${index}`;

									return (
										<div
											class="hs-accordion border-b border-white/10"
											id={headingId}
										>
											<button
												type="button"
												class="hs-accordion-toggle flex w-full items-center justify-between gap-6 py-6 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#c59d56]"
												aria-expanded="false"
												aria-controls={collapseId}
											>
												<span class="font-serif text-xl font-medium text-cream sm:text-2xl">
													{group.title}
												</span>

												<span
													class="relative h-4 w-4 shrink-0 text-[#c59d56]"
													aria-hidden="true"
												>
													<span class="hs-accordion-active:hidden absolute left-0 top-1/2 h-px w-4 -translate-y-1/2 bg-current" />
													<span class="hs-accordion-active:hidden absolute left-1/2 top-0 h-4 w-px -translate-x-1/2 bg-current" />
													<span class="hs-accordion-active:block absolute left-0 top-1/2 hidden h-px w-4 -translate-y-1/2 bg-current" />
												</span>
											</button>

											<div
												id={collapseId}
												class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300"
												role="region"
												aria-labelledby={headingId}
											>
												<div class="flex flex-wrap gap-2 pb-7">
													{group.skills.map((skill) => (
														<span class="rounded-full border border-white/10 bg-white/[0.025] px-3 py-2 font-sans text-xs font-medium text-mist">
															{skill}
														</span>
													))}
												</div>
											</div>
										</div>
									);
								})
							}
						</div>
					</div>
				</div>

				<div class="mt-24 border-t border-white/10 pt-14 sm:pt-16">
					<div class="max-w-3xl">
						<p class="section-kicker">Project Goals</p>
						<h3
							class="mt-5 font-serif text-3xl font-medium leading-tight tracking-tight text-cream sm:text-4xl"
						>
							What I wanted this project to prove.
						</h3>
						<p
							class="mt-5 max-w-2xl font-sans text-sm leading-relaxed text-mist sm:text-base"
						>
							ApotheonAI gave me one project where I could turn those skills
							into clear development goals and carry them through to a finished,
							deployed website.
						</p>
					</div>

					<div class="mt-12 grid border-y border-white/10 md:grid-cols-3">
						{
							objectives.map((objective) => (
								<article class="border-white/10 py-10 md:border-r md:px-8 md:first:pl-0 md:last:border-r-0 lg:py-12">
									<p class="font-sans text-xs font-semibold tracking-[0.2em] text-[#c59d56]">
										{objective.number}
									</p>
									<h3 class="mt-5 font-serif text-2xl font-medium tracking-tight text-cream sm:text-3xl">
										{objective.title}
									</h3>
									<p class="mt-4 font-sans text-sm leading-relaxed text-mist sm:text-base">
										{objective.body}
									</p>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
