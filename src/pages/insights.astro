---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ApotheonAI | Insights">
	<article class="container-page py-16">
		<div class="max-w-3xl">
			<p class="section-kicker mb-4">Insights</p>
			<h1
				class="font-serif text-4xl font-medium tracking-tight text-cream sm:text-5xl"
			>
				Explore the frontier of AI security
			</h1>
			<p class="mt-6 font-sans text-base leading-relaxed text-mist sm:text-lg">
				Practical perspectives on enterprise AI, generative AI security,
				governance, and responsible adoption. This page is a placeholder for the
				full insights library.
			</p>
		</div>
	</article>
</BaseLayout>
