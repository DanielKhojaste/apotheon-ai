---
type Pt = [number, number];

type Strand = {
  p0: Pt;
  c: Pt;
  p1: Pt;
};

const STRANDS_PER_SIDE = 8;

/*
  Nested strands that converge behind the helmet crest and sweep
  outward-down to the screen edge, each bowed slightly upward.
  Coordinates live in a 0-100 space stretched to the viewport;
  strokes stay crisp via vector-effect: non-scaling-stroke.
*/
const rightStrands: Strand[] = Array.from({ length: STRANDS_PER_SIDE }, (_, i) => {
  const p0: Pt = [50, 5 + i * 7.4];
  const p1: Pt = [100, 9 + i * 11.3];
  const midY = (p0[1] + p1[1]) / 2;
  const c: Pt = [73, midY - (3.5 + i * 0.7)];
  return { p0, c, p1 };
});

function mirror(s: Strand): Strand {
  return {
    p0: [100 - s.p0[0], s.p0[1]],
    c: [100 - s.c[0], s.c[1]],
    p1: [100 - s.p1[0], s.p1[1]],
  };
}

const strands = [...rightStrands, ...rightStrands.map(mirror)];

function pathD(s: Strand) {
  return `M ${s.p0[0]} ${s.p0[1]} Q ${s.c[0]} ${s.c[1]} ${s.p1[0]} ${s.p1[1]}`;
}

function pointAt(s: Strand, t: number): Pt {
  const mt = 1 - t;
  return [
    mt * mt * s.p0[0] + 2 * mt * t * s.c[0] + t * t * s.p1[0],
    mt * mt * s.p0[1] + 2 * mt * t * s.c[1] + t * t * s.p1[1],
  ];
}

function pct(n: number) {
  return `${Math.round(n * 100) / 100}%`;
}

function inTitleGap(x: number, y: number) {
  return y > 58 && y < 96 && Math.abs(x - 50) < 16;
}

type Dot = { x: number; y: number; r: number; spark: boolean; delay: string };

/* Dots sit on the strands themselves, staggered so no two neighbours align. */
const dotPlans = [
  [0.55, 0.92],
  [0.38, 0.74],
  [0.6, 0.88],
  [0.45, 0.8],
  [0.35, 0.68, 0.95],
  [0.5, 0.85],
  [0.42, 0.76],
  [0.58, 0.9],
];

const sparkDelays = ["0.2s", "1.4s", "2.6s", "0.8s", "3.3s", "1.9s", "0.5s", "2.2s"];

const dots: Dot[] = [];

strands.forEach((strand, si) => {
  const plan = dotPlans[si % dotPlans.length];
  plan.forEach((t, di) => {
    const [x, y] = pointAt(strand, t);
    if (inTitleGap(x, y)) return;
    dots.push({
      x,
      y,
      r: 1.5 + ((si + di) % 3) * 0.45,
      spark: (si + di) % 3 === 0,
      delay: sparkDelays[(si + di) % sparkDelays.length],
    });
  });
});
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="hero-stage">
    <svg class="hero-constellation" aria-hidden="true">
      <defs>
        <filter
          id="constellation-line-glow"
          filterUnits="userSpaceOnUse"
          x="-8%"
          y="-8%"
          width="116%"
          height="116%"
          color-interpolation-filters="sRGB"
        >
          <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
        </filter>
        <mask id="constellation-hole" maskUnits="userSpaceOnUse">
          <rect width="100%" height="100%" fill="white"></rect>
          <ellipse cx="50%" cy="34%" rx="13.2%" ry="39%" fill="black"></ellipse>
        </mask>
      </defs>
      <g mask="url(#constellation-hole)">
        <g class="hero-constellation-line-glow" filter="url(#constellation-line-glow)">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" width="100%" height="100%" overflow="visible">
            {strands.map((strand) => (
              <path d={pathD(strand)} fill="none"></path>
            ))}
          </svg>
        </g>
        <g class="hero-constellation-lines">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" width="100%" height="100%" overflow="visible">
            {strands.map((strand) => (
              <path d={pathD(strand)} fill="none"></path>
            ))}
          </svg>
        </g>
        <g class="hero-constellation-stars">
          {dots.map((dot) => (
            <circle
              class:list={[dot.spark && "spark-node"]}
              cx={pct(dot.x)}
              cy={pct(dot.y)}
              r={dot.r}
              style={dot.spark ? `animation-delay: ${dot.delay}` : undefined}
            ></circle>
          ))}
        </g>
      </g>
    </svg>

    <div class="hero-glow"></div>

    <div class="hero-cluster">
      <img
        class="hero-helmet"
        src="/spartan-helmet-front-hero-snug.png"
        alt="Weathered bronze Spartan helmet"
        width="2053"
        height="3790"
        fetchpriority="high"
      />

      <h1 id="hero-heading" class="hero-title">
        <span class="hero-title-stack">
          <span class="hero-word-ascend hero-metal">ASCEND</span>
          <span class="hero-word-mid hero-metal">TO THE</span>
          <span class="hero-word-divine hero-metal">DIVINE</span>
        </span>
      </h1>
    </div>
  </div>
</section>
