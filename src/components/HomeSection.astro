---
interface Props {
	id: string;
	kicker: string;
	heading: string;
}

const { id, kicker, heading } = Astro.props;
---

<section id={id} class="container-page border-t border-gold/15 py-24 sm:py-28">
	<p class="section-kicker mb-4">{kicker}</p>

	<h2
		class="font-serif text-3xl font-medium tracking-tight text-cream sm:text-4xl"
	>
		{heading}
	</h2>

	<slot />
</section>
