---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
	{
		label: "Email",
		href: "mailto:danielkhojaste101@gmail.com",
		description: "Reach me directly at danielkhojaste101@gmail.com.",
		number: "01",
		external: false,
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/aref-khojaste/",
		description:
			"Connect with me professionally and see more of my background.",
		number: "02",
		external: true,
	},
	{
		label: "GitHub",
		href: "https://github.com/DanielKhojaste",
		description: "Explore my code, projects, and development work.",
		number: "03",
		external: true,
	},
];

const visualLinks = [
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/aref-khojaste/",
		icon: "mdi:linkedin",
		position: "contact-node-link-1",
		external: true,
	},
	{
		label: "GitHub",
		href: "https://github.com/DanielKhojaste",
		icon: "mdi:github",
		position: "contact-node-link-2",
		external: true,
	},
	{
		label: "Email",
		href: "mailto:danielkhojaste101@gmail.com",
		icon: "mdi:email-outline",
		position: "contact-node-link-3",
		external: false,
	},
] as const;
---

<BaseLayout title="Contact | ApotheonAI">
	<main>
		<section class="relative overflow-hidden border-b border-white/10">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_78%_34%,rgba(197,157,86,0.12),transparent_31%)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="container-page relative grid min-h-[72vh] items-center gap-16 py-24 sm:py-28 lg:grid-cols-[1.05fr_0.95fr] lg:gap-24 lg:py-32"
			>
				<div class="max-w-3xl">
					<p class="section-kicker">Contact</p>

					<h1
						class="mt-6 max-w-4xl font-serif text-5xl font-medium leading-[0.92] tracking-[-0.04em] text-cream sm:text-6xl lg:text-7xl xl:text-8xl"
					>
						Daniel Khojaste
					</h1>

					<p
						class="mt-5 font-sans text-sm font-medium uppercase tracking-[0.16em] text-[#c59d56] sm:text-base"
					>
						Designer · Developer · Constant learner
					</p>

					<p
						class="mt-7 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						I’m the designer and developer behind ApotheonAI. I enjoy learning
						new tools by building with them, and I care about creating polished,
						thoughtful digital experiences.
					</p>

					<p
						class="mt-5 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						If you’d like to discuss an opportunity, a project, or this work,
						you can reach me directly below.
					</p>
				</div>

				<div class="contact-visual relative mx-auto w-full max-w-[31rem]">
					<p class="contact-visual-prompt">Select a connection on the orbit</p>

					<div class="contact-visual-grid" aria-hidden="true"></div>
					<div class="contact-orbit contact-orbit-outer" aria-hidden="true">
					</div>
					<div class="contact-orbit contact-orbit-inner" aria-hidden="true">
					</div>

					<div class="contact-core" aria-hidden="true">
						<span class="contact-core-index">A</span>
						<div>
							<p>AVAILABLE TO CONNECT</p>
							<span>Design · Development · AI</span>
						</div>
					</div>

					{
						visualLinks.map((link) => (
							<a
								href={link.href}
								target={link.external ? "_blank" : undefined}
								rel={link.external ? "noopener noreferrer" : undefined}
								class={`contact-node-link ${link.position}`}
								aria-label={
									link.external
										? `Open Daniel Khojaste's ${link.label}`
										: "Email Daniel Khojaste"
								}
								data-contact-node-link
							>
								<span
									class="contact-node"
									data-contact-node
									aria-hidden="true"
								/>

								<span class="contact-node-pill-position" aria-hidden="true">
									<span class="contact-node-pill" data-contact-pill>
										<Icon
											name={link.icon}
											size="1.85rem"
											class="contact-node-icon"
											data-contact-icon
										/>

										<span
											class="contact-node-pill-details"
											data-contact-pill-details
										>
											<span>{link.label}</span>
											<span
												class="contact-node-pill-arrow"
												data-contact-pill-arrow
											>
												↗
											</span>
										</span>
									</span>
								</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section
			class="border-b border-white/10 pb-28 pt-20 sm:pb-32 sm:pt-24 lg:pb-36 lg:pt-28"
		>
			<div class="container-page">
				<div class="grid gap-14 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
					<div>
						<p class="section-kicker">Connect</p>

						<h2
							class="mt-5 max-w-xl font-serif text-4xl font-medium leading-tight tracking-tight text-cream sm:text-5xl"
						>
							Let’s connect.
						</h2>

						<p
							class="mt-6 max-w-lg font-sans text-base leading-relaxed text-mist"
						>
							Email is the quickest way to reach me. You can also connect with
							me on LinkedIn or explore more of my work on GitHub.
						</p>
					</div>

					<nav aria-label="Contact links" class="contact-links">
						{
							links.map((link) => (
								<a
									href={link.href}
									target={link.external ? "_blank" : undefined}
									rel={link.external ? "noopener noreferrer" : undefined}
									class="contact-link group"
								>
									<span class="contact-link-number">{link.number}</span>

									<div>
										<h3 class="contact-link-title">{link.label}</h3>
										<p class="contact-link-description">{link.description}</p>
									</div>

									<span class="contact-link-arrow" aria-hidden="true">
										↗
									</span>
								</a>
							))
						}
					</nav>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.contact-visual {
		aspect-ratio: 1 / 1;
		min-height: 24rem;
	}

	.contact-visual-grid {
		position: absolute;
		inset: 8%;
		background-image:
			linear-gradient(rgba(197, 157, 86, 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgba(197, 157, 86, 0.07) 1px, transparent 1px);
		background-size: 42px 42px;
		mask-image: radial-gradient(circle, black 28%, transparent 72%);
		-webkit-mask-image: radial-gradient(circle, black 28%, transparent 72%);
	}

	.contact-orbit {
		position: absolute;
		left: 50%;
		top: 50%;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		transform: translate(-50%, -50%);
	}

	.contact-orbit-outer {
		width: 78%;
		height: 78%;
	}

	.contact-orbit-inner {
		width: 48%;
		height: 48%;
		border-color: rgba(197, 157, 86, 0.32);
	}

	.contact-core {
		position: absolute;
		left: 50%;
		top: 50%;
		display: flex;
		width: 14rem;
		align-items: center;
		gap: 0.9rem;
		border: 1px solid rgba(197, 157, 86, 0.34);
		background: rgba(9, 9, 11, 0.94);
		padding: 1rem 1.1rem;
		transform: translate(-50%, -50%);
		box-shadow: 0 0 42px rgba(197, 157, 86, 0.08);
	}

	.contact-core-index {
		display: grid;
		width: 2.45rem;
		height: 2.45rem;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid rgba(197, 157, 86, 0.45);
		color: #c59d56;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	.contact-core p {
		margin: 0;
		color: var(--color-cream);
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.contact-core div span {
		display: block;
		margin-top: 0.3rem;
		color: rgba(210, 207, 199, 0.58);
		font-family: var(--font-sans);
		font-size: 0.56rem;
		letter-spacing: 0.12em;
	}

	.contact-visual-prompt {
		position: absolute;
		left: 50%;
		top: 1.5%;
		z-index: 20;
		margin: 0;
		transform: translateX(-50%);
		white-space: nowrap;
		color: rgba(210, 207, 199, 0.52);
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.contact-visual-prompt::before {
		content: "";
		display: inline-block;
		width: 0.32rem;
		height: 0.32rem;
		margin-right: 0.5rem;
		border-radius: 999px;
		background: var(--color-gold);
		box-shadow: 0 0 10px rgba(197, 157, 86, 0.3);
		vertical-align: 0.08rem;
	}

	.contact-node-link {
		--icon-x: 0rem;
		--icon-y: 0rem;
		position: absolute;
		z-index: 10;
		width: 4.5rem;
		height: 4.5rem;
		color: rgba(210, 207, 199, 0.68);
		transform: translate(-50%, -50%);
	}

	.contact-node {
		position: absolute;
		left: calc(50% - 0.26rem);
		top: calc(50% - 0.26rem);
		width: 0.52rem;
		height: 0.52rem;
		border: 1px solid rgba(197, 157, 86, 0.82);
		border-radius: 999px;
		background: #09090b;
		box-shadow: 0 0 14px rgba(197, 157, 86, 0.25);
		transform-origin: center;
	}

	.contact-node-pill-position {
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 20;
		width: max-content;
		height: 2.75rem;
		pointer-events: none;
		transform: translate(
			calc(var(--icon-x) - 1.375rem),
			calc(var(--icon-y) - 1.375rem)
		);
	}

	.contact-node-pill {
		display: flex;
		width: 2.75rem;
		height: 100%;
		align-items: center;
		overflow: hidden;
		white-space: nowrap;
		border: 1px solid rgba(197, 157, 86, 0);
		border-radius: 999px;
		background: rgba(9, 9, 11, 0);
		box-shadow: none;
		color: rgba(210, 207, 199, 0.68);
		pointer-events: auto;
		will-change: width;
	}

	.contact-node-icon {
		display: block;
		width: 2.75rem;
		flex: 0 0 2.75rem;
		transform-origin: center;
	}

	.contact-node-pill-details {
		display: flex;
		visibility: hidden;
		flex: 0 0 auto;
		align-items: baseline;
		gap: 0.55rem;
		padding-right: 0.65rem;
		opacity: 0;
		color: var(--color-cream);
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		transform: translateX(-0.35rem);
	}

	.contact-node-pill-arrow {
		position: relative;
		top: 0.1rem;
		flex: 0 0 auto;
		color: var(--color-gold);
		font-size: 0.78rem;
		line-height: 1;
	}

	/* Exact points on the 78% outer orbit. Icons sit radially outside it. */
	.contact-node-link-1 {
		left: 12.33%;
		top: 39.91%;
		--icon-x: -2rem;
		--icon-y: -0.55rem;
	}

	.contact-node-link-2 {
		left: 79.88%;
		top: 24.93%;
		--icon-x: 1.65rem;
		--icon-y: -1.35rem;
	}

	.contact-node-link-3 {
		left: 78.98%;
		top: 76.1%;
		--icon-x: 1.6rem;
		--icon-y: 1.4rem;
	}

	.contact-node-link:focus-visible {
		border-radius: 999px;
		outline: 1px solid rgba(197, 157, 86, 0.45);
		outline-offset: -0.25rem;
	}

	.contact-links {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.contact-link {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		align-items: center;
		gap: 1rem;
		min-height: 9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding: 1.5rem 0;
		transition:
			border-color 220ms ease,
			padding-left 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.contact-link:hover {
		border-color: rgba(197, 157, 86, 0.5);
		padding-left: 0.45rem;
	}

	.contact-link:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 4px;
	}

	.contact-link-number {
		color: rgba(197, 157, 86, 0.7);
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.contact-link-title {
		color: var(--color-cream);
		font-family: var(--font-serif);
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 500;
		line-height: 1;
		transition: color 200ms ease;
	}

	.contact-link-description {
		max-width: 32rem;
		margin-top: 0.65rem;
		color: rgba(210, 207, 199, 0.66);
		font-family: var(--font-sans);
		font-size: 0.82rem;
		line-height: 1.6;
	}

	.contact-link-arrow {
		color: rgba(197, 157, 86, 0.6);
		font-family: var(--font-sans);
		font-size: 1rem;
		transition:
			color 200ms ease,
			transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.contact-link:hover .contact-link-title,
	.contact-link:hover .contact-link-arrow {
		color: var(--color-gold-bright);
	}

	.contact-link:hover .contact-link-arrow {
		transform: translate(0.16rem, -0.16rem);
	}

	@media (max-width: 639px) {
		.contact-visual {
			min-height: 20rem;
		}

		.contact-core {
			width: 12.4rem;
			padding: 0.85rem;
		}

		.contact-node-link {
			width: 4rem;
			height: 4rem;
		}

		.contact-node-link-1 {
			--icon-x: -1.7rem;
			--icon-y: -0.45rem;
		}

		.contact-node-link-2 {
			--icon-x: 1.4rem;
			--icon-y: -1.15rem;
		}

		.contact-node-link-3 {
			--icon-x: 1.4rem;
			--icon-y: 1.2rem;
		}

		.contact-node-pill {
			width: 2.55rem;
		}

		.contact-node-icon {
			width: 2.55rem;
			flex-basis: 2.55rem;
		}

		.contact-node-pill-details {
			font-size: 0.62rem;
		}

		.contact-link {
			grid-template-columns: 2rem 1fr auto;
			min-height: 8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-node,
		.contact-link,
		.contact-link-title,
		.contact-link-arrow {
			transition: none;
		}
	}
</style>

<script>
	import { gsap } from "gsap";

	const CONTACT_ORBIT_ANIMATION_DURATION = 0.36;

	const initContactNodes = () => {
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		document
			.querySelectorAll<HTMLElement>("[data-contact-node-link]")
			.forEach((link) => {
				if (link.dataset.contactNodeReady === "true") return;

				const node = link.querySelector<HTMLElement>("[data-contact-node]");
				const icon = link.querySelector<SVGElement>("[data-contact-icon]");
				const pill = link.querySelector<HTMLElement>("[data-contact-pill]");
				const details = link.querySelector<HTMLElement>(
					"[data-contact-pill-details]",
				);
				const pillArrow = link.querySelector<HTMLElement>(
					"[data-contact-pill-arrow]",
				);

				if (!node || !icon || !pill || !details || !pillArrow) return;

				link.dataset.contactNodeReady = "true";

				const closedWidth = pill.getBoundingClientRect().width;
				const openWidth = Math.ceil(pill.scrollWidth);

				if (prefersReducedMotion) {
					const show = () => {
						gsap.set(node, {
							scale: 0.86,
							borderColor: "var(--color-gold)",
							backgroundColor: "var(--color-gold)",
							boxShadow: "0 0 18px rgba(201, 165, 106, 0.38)",
						});
						gsap.set(icon, {
							scale: 0.86,
							color: "var(--color-gold)",
						});
						gsap.set(pill, {
							width: openWidth,
							borderColor: "rgba(197, 157, 86, 0.34)",
							backgroundColor: "rgba(9, 9, 11, 0.96)",
							boxShadow:
								"0 10px 30px rgba(0, 0, 0, 0.28), 0 0 24px rgba(197, 157, 86, 0.06)",
						});
						gsap.set(details, {
							autoAlpha: 1,
							x: 0,
						});
						gsap.set(pillArrow, { x: 2, y: 0 });
					};

					const hide = () => {
						gsap.set(node, {
							scale: 1,
							clearProps: "borderColor,backgroundColor,boxShadow",
						});
						gsap.set(icon, {
							scale: 1,
							clearProps: "color",
						});
						gsap.set(details, {
							autoAlpha: 0,
							x: -5,
						});
						gsap.set(pillArrow, { x: 0, y: 0 });
						gsap.set(pill, {
							width: closedWidth,
							borderColor: "rgba(197, 157, 86, 0)",
							backgroundColor: "rgba(9, 9, 11, 0)",
							boxShadow: "none",
						});
					};

					hide();
					link.addEventListener("mouseenter", show);
					link.addEventListener("mouseleave", hide);
					link.addEventListener("focus", show);
					link.addEventListener("blur", hide);
					return;
				}

				gsap.set(details, {
					autoAlpha: 0,
					x: -5,
				});

				const timeline = gsap.timeline({
					paused: true,
					onReverseComplete: () => {
						gsap.set(details, { visibility: "hidden" });
					},
				});

				timeline
					.set(details, { visibility: "visible" }, 0)
					.to(
						node,
						{
							scale: 0.86,
							borderColor: "var(--color-gold)",
							backgroundColor: "var(--color-gold)",
							boxShadow: "0 0 18px rgba(201, 165, 106, 0.38)",
							duration: CONTACT_ORBIT_ANIMATION_DURATION,
							ease: "power2.out",
						},
						0,
					)
					.to(
						icon,
						{
							scale: 0.86,
							color: "var(--color-gold)",
							duration: CONTACT_ORBIT_ANIMATION_DURATION,
							ease: "power2.out",
						},
						0,
					)
					.to(
						pill,
						{
							width: openWidth,
							borderColor: "rgba(197, 157, 86, 0.34)",
							backgroundColor: "rgba(9, 9, 11, 0.96)",
							boxShadow:
								"0 10px 30px rgba(0, 0, 0, 0.28), 0 0 24px rgba(197, 157, 86, 0.06)",
							duration: CONTACT_ORBIT_ANIMATION_DURATION,
							ease: "power3.out",
						},
						0,
					)
					.to(
						details,
						{
							autoAlpha: 1,
							x: 0,
							duration: CONTACT_ORBIT_ANIMATION_DURATION * 0.65,
							ease: "power2.out",
						},
						CONTACT_ORBIT_ANIMATION_DURATION * 0.45,
					)
					.to(
						pillArrow,
						{
							x: 2,
							y: 0,
							duration: CONTACT_ORBIT_ANIMATION_DURATION * 0.6,
							ease: "power2.out",
						},
						CONTACT_ORBIT_ANIMATION_DURATION * 0.55,
					);

				const open = () => {
					timeline.timeScale(1).play();
				};

				const close = () => {
					timeline.timeScale(1.15).reverse();
				};

				link.addEventListener("mouseenter", open);
				link.addEventListener("mouseleave", close);
				link.addEventListener("focus", open);
				link.addEventListener("blur", close);
			});
	};

	initContactNodes();
	document.addEventListener("astro:page-load", initContactNodes);
</script>
