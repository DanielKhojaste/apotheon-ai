---
const links = [
	{ href: "/platform", label: "Platform" },
	{ href: "/capabilities", label: "Capabilities" },
	{ href: "/insights", label: "Insights" },
	{ href: "/about", label: "About" },
];
---

<header class="site-header is-visible" data-site-header>
	<nav
		class="site-header-bar container-page relative flex items-center justify-between py-4"
		aria-label="Primary"
	>
		<a href="/" class="group flex items-center" aria-label="ApotheonAI home">
			<span
				class="logo-mark h-9 w-5 bg-cream transition-colors duration-200 sm:h-10 sm:w-[1.4rem] group-hover:bg-gold"
				aria-hidden="true"></span>
		</a>

		<button
			type="button"
			class="nav-toggle flex items-center justify-center text-cream transition-colors duration-200 hover:text-gold"
			id="hs-header-overlay"
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls="hs-header-overlay-nav"
			aria-label="Toggle navigation"
			data-hs-overlay="#hs-header-overlay-nav"
		>
			<span class="nav-burger" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
		</button>
	</nav>

	<div
		id="hs-header-overlay-nav"
		class="hs-overlay pointer-events-auto hidden fixed inset-0 z-40 flex min-h-svh flex-col items-center justify-center gap-8 bg-void/94 px-6 pb-16 pt-24 [--close-when-click-inside:true] [--overlay-backdrop:false]"
		role="dialog"
		tabindex="-1"
		aria-label="Site navigation"
	>
		{
			links.map((link) => (
				<a
					class="font-serif text-2xl tracking-wide text-cream/90 transition-colors duration-200 hover:text-gold sm:text-3xl"
					href={link.href}
				>
					{link.label}
				</a>
			))
		}
	</div>
</header>

<script>
	import "../scripts/header.ts";
</script>
