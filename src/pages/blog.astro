---
import { sanityClient } from "sanity:client";
import BlogCard from "../components/BlogCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type BlogPost = {
	_id: string;
	title: string;
	slug: {
		current: string;
	};
	excerpt?: string;
	publishedAt?: string;
	authorName?: string;
	authorProfilePictureUrl?: string;
	headerImageUrl?: string;
	headerImageAlt?: string;
};

const posts = await sanityClient.fetch<BlogPost[]>(`
	*[_type == "post" && defined(slug.current)]
	| order(publishedAt desc, _createdAt desc) {
		_id,
		title,
		slug,
		excerpt,
		publishedAt,
		"authorName": author->name,
		"authorProfilePictureUrl": author->profilePicture.asset->url,
		"headerImageUrl": headerImage.asset->url,
		"headerImageAlt": headerImage.alt
	}
`);
---

<BaseLayout title="Blog | ApotheonAI">
	<main>
		<!-- Hero -->
		<section class="relative overflow-hidden border-b border-white/10">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_76%_34%,rgba(197,157,86,0.12),transparent_31%)]"
				aria-hidden="true"
			>
			</div>

			<div class="container-page relative py-24 sm:py-28 lg:py-32">
				<div class="max-w-4xl">
					<p class="section-kicker">Blog</p>

					<h1
						class="mt-6 max-w-4xl font-serif text-5xl font-medium leading-[0.95] tracking-[-0.035em] text-cream sm:text-6xl lg:text-7xl xl:text-8xl"
					>
						Ideas, notes,
						<span class="block text-mist">and things I’m learning.</span>
					</h1>

					<p
						class="mt-8 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						This is where I share posts about frontend development, AI, product
						thinking, and the process behind projects like ApotheonAI.
					</p>
				</div>
			</div>
		</section>

		<!-- Posts -->
		<section class="pb-28 pt-20 sm:pb-32 sm:pt-24 lg:pb-36 lg:pt-28">
			<div class="container-page">
				<div class="mx-auto max-w-[84rem]">
					<div class="mb-10 flex items-center justify-between gap-6 sm:mb-12">
						<p class="section-kicker">Latest Posts</p>

						<p class="section-kicker">
							{posts.length}{posts.length === 1 ? " Article" : " Articles"}
						</p>
					</div>

					{
						posts.length > 0 ? (
							<div class="grid gap-x-8 gap-y-10 md:grid-cols-2 xl:grid-cols-3 xl:gap-x-10">
								{posts.map((post, index) => (
									<BlogCard
										title={post.title}
										slug={post.slug.current}
										excerpt={post.excerpt}
										publishedAt={post.publishedAt}
										authorName={post.authorName}
										authorProfilePictureUrl={post.authorProfilePictureUrl}
										headerImageUrl={post.headerImageUrl}
										headerImageAlt={post.headerImageAlt}
										priority={index === 0}
									/>
								))}
							</div>
						) : (
							<div class="border-y border-white/10 py-16 sm:py-20">
								<p class="section-kicker">No Posts Yet</p>
								<p class="mt-5 max-w-xl font-serif text-3xl text-cream sm:text-4xl">
									The journal is still being written.
								</p>
							</div>
						)
					}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
