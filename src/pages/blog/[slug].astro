---
import type { PortableTextBlock } from "@portabletext/types";
import { PortableText } from "astro-portabletext";
import { sanityClient } from "sanity:client";

import BaseLayout from "../../layouts/BaseLayout.astro";

type BlogPost = {
	title: string;
	publishedAt?: string;
	content: PortableTextBlock[];
	authorName?: string;
	headerImageUrl?: string;
	headerImageAlt?: string;
	headerImageCredit?: string;
	headerImageSourceUrl?: string;
};

export async function getStaticPaths() {
	const posts = await sanityClient.fetch<{ slug: string }[]>(`
		*[_type == "post" && defined(slug.current)] {
			"slug": slug.current
		}
	`);

	return posts.map((post) => ({
		params: { slug: post.slug },
	}));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch<BlogPost | null>(
	`
		*[_type == "post" && slug.current == $slug][0] {
			title,
			publishedAt,
			content,
			"authorName": author->name,
			"headerImageUrl": headerImage.asset->url,
			"headerImageAlt": headerImage.alt,
			"headerImageCredit": headerImage.credit,
			"headerImageSourceUrl": headerImage.sourceUrl
		}
	`,
	{ slug },
);

if (!post) {
	return Astro.redirect("/blog");
}

const publishedDate = post.publishedAt
	? new Date(post.publishedAt).toLocaleDateString("en-CA", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;
---

<BaseLayout title={`${post.title} | ApotheonAI`}>
	<main class="bg-black">
		<!-- Full-width editorial hero -->
		<section
			class:list={[
				"relative isolate flex overflow-hidden border-b border-white/10",
				post.headerImageUrl
					? "min-h-[72svh] lg:min-h-[78svh]"
					: "min-h-[34rem]",
			]}
		>
			{
				post.headerImageUrl ? (
					<>
						<img
							src={post.headerImageUrl}
							alt={post.headerImageAlt ?? ""}
							class="absolute inset-0 -z-40 h-full w-full object-cover object-center"
							loading="eager"
							fetchpriority="high"
						/>

						<!-- Keep the navbar readable without visually boxing it in. -->
						<div
							class="absolute inset-x-0 top-0 -z-30 h-32 bg-gradient-to-b from-black via-black/75 to-transparent"
							aria-hidden="true"
						></div>

						<!-- Editorial image treatment. -->
						<div
							class="absolute inset-0 -z-30 bg-black/22"
							aria-hidden="true"
						></div>
						<div
							class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(0,0,0,0.90)_0%,rgba(0,0,0,0.72)_32%,rgba(0,0,0,0.28)_66%,rgba(0,0,0,0.12)_100%)]"
							aria-hidden="true"
						></div>
						<div
							class="absolute inset-0 -z-20 bg-[linear-gradient(0deg,rgba(0,0,0,0.94)_0%,rgba(0,0,0,0.18)_50%,rgba(0,0,0,0.32)_100%)]"
							aria-hidden="true"
						></div>
						<div
							class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_68%,rgba(197,157,86,0.12),transparent_34%)]"
							aria-hidden="true"
						></div>
					</>
				) : (
					<>
						<div
							class="absolute inset-0 -z-30 bg-[radial-gradient(circle_at_22%_58%,rgba(197,157,86,0.14),transparent_32%)]"
							aria-hidden="true"
						></div>
						<div
							class="absolute inset-0 -z-20 bg-gradient-to-b from-black via-black/90 to-black"
							aria-hidden="true"
						></div>
					</>
				)
			}

			<div
				class="container-page flex w-full flex-col justify-between pb-10 pt-28 sm:pb-12 sm:pt-32 lg:pb-14 lg:pt-36"
			>
				<header class="max-w-4xl pt-16 sm:pt-20 lg:pt-24">
					<div class="flex items-center gap-4">
						<span class="h-px w-12 bg-gold/45" aria-hidden="true"></span>
						<span class="section-kicker">Article</span>
					</div>

					<h1
						class="mt-6 max-w-4xl font-serif text-[clamp(2.6rem,5.2vw,5.1rem)] font-medium leading-[0.96] tracking-[-0.035em] text-cream"
					>
						{post.title}
					</h1>

					<div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
						{
							post.authorName && (
								<span
									class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.15em] text-gold"
								>
									{post.authorName}
								</span>
							)
						}

						{
							post.authorName && publishedDate && (
								<span
									class="h-1 w-1 rounded-full bg-cream/30"
									aria-hidden="true"
								></span>
							)
						}

						{
							publishedDate && (
								<time
									datetime={post.publishedAt}
									class="font-sans text-[0.7rem] font-medium uppercase tracking-[0.15em] text-mist"
								>
									{publishedDate}
								</time>
							)
						}
					</div>
				</header>

				<div class="mt-12 flex items-end justify-between gap-6">
					<a
						href="/blog"
						class="group inline-flex w-fit items-center gap-2 font-sans text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-mist/70 transition-colors hover:text-cream focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
					>
						<span
							class="text-gold transition-transform duration-300 group-hover:-translate-x-1"
							aria-hidden="true"
						>
							←
						</span>
						Back to blog
					</a>

					{
						post.headerImageUrl &&
							(post.headerImageCredit || post.headerImageSourceUrl) && (
								<p class="ml-auto max-w-sm text-right font-sans text-[0.6rem] leading-relaxed text-mist/60">
									{post.headerImageCredit && (
										<span>Image: {post.headerImageCredit}</span>
									)}
									{post.headerImageCredit && post.headerImageSourceUrl && (
										<span aria-hidden="true"> · </span>
									)}
									{post.headerImageSourceUrl && (
										<a
											href={post.headerImageSourceUrl}
											target="_blank"
											rel="noreferrer"
											class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-cream"
										>
											Source
										</a>
									)}
								</p>
							)
					}
				</div>
			</div>
		</section>

		<!-- Article body -->
		<section class="border-b border-white/5">
			<div class="container-page py-16 sm:py-20 lg:py-24">
				<article class="article-content mx-auto max-w-3xl">
					<PortableText value={post.content} />
				</article>

				<div
					class="mx-auto mt-16 max-w-3xl border-t border-white/10 pt-8 sm:mt-20"
				>
					<a
						href="/blog"
						class="group inline-flex w-fit items-center gap-3 border border-white/12 bg-white/[0.02] px-5 py-3 font-sans text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-mist transition-colors hover:border-gold/45 hover:text-cream focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
					>
						<span
							class="text-gold transition-transform duration-300 group-hover:-translate-x-1"
							aria-hidden="true"
						>
							←
						</span>
						All articles
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.article-content {
		color: var(--color-mist);
		font-family: var(--font-sans);
		font-size: 1rem;
		line-height: 1.9;
	}

	.article-content :global(p) {
		margin-top: 1.55rem;
	}

	.article-content :global(p:first-child) {
		margin-top: 0;
		color: var(--color-cream);
		font-size: 1.1rem;
		line-height: 1.85;
	}

	.article-content :global(h2) {
		margin-top: 4rem;
		color: var(--color-cream);
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 4vw, 3rem);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.03em;
	}

	.article-content :global(h2::before) {
		content: "";
		display: block;
		width: 2.25rem;
		height: 1px;
		margin-bottom: 1rem;
		background: rgba(197, 157, 86, 0.6);
	}

	.article-content :global(h3) {
		margin-top: 2.8rem;
		color: var(--color-cream);
		font-family: var(--font-serif);
		font-size: 1.7rem;
		font-weight: 500;
		line-height: 1.18;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin-top: 1.55rem;
		padding-left: 1.35rem;
	}

	.article-content :global(ul) {
		list-style: disc;
	}

	.article-content :global(ol) {
		list-style: decimal;
	}

	.article-content :global(li) {
		margin-top: 0.65rem;
		padding-left: 0.25rem;
	}

	.article-content :global(strong),
	.article-content :global(em) {
		color: var(--color-cream);
	}

	.article-content :global(strong) {
		font-weight: 600;
	}

	.article-content :global(a) {
		color: var(--color-gold);
		text-decoration: underline;
		text-decoration-color: rgba(197, 157, 86, 0.42);
		text-underline-offset: 0.23em;
		transition:
			color 180ms ease,
			text-decoration-color 180ms ease;
	}

	.article-content :global(a:hover) {
		color: var(--color-cream);
		text-decoration-color: rgba(243, 235, 221, 0.5);
	}

	.article-content :global(blockquote) {
		margin-top: 2.4rem;
		border-left: 1px solid rgba(197, 157, 86, 0.58);
		padding-left: 1.55rem;
		color: var(--color-cream);
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-style: italic;
		line-height: 1.55;
	}

	.article-content :global(code) {
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.04);
		padding: 0.1rem 0.3rem;
		color: var(--color-cream);
		font-size: 0.9em;
	}
</style>
