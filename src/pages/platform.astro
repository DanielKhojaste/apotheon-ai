---
import BaseLayout from "../layouts/BaseLayout.astro";

const capabilities = [
	{
		number: "01",
		kicker: "AI Visibility",
		title: "Understand where AI lives.",
		body: "Map the models, tools, applications, and services in use across an organization.",
	},
	{
		number: "02",
		kicker: "Threat Detection",
		title: "Surface unusual activity.",
		body: "Bring risky interactions, policy events, and unexpected behavior into one review flow.",
	},
	{
		number: "03",
		kicker: "Prompt Protection",
		title: "Protect AI interactions.",
		body: "Inspect the path between users, applications, enterprise data, and models.",
	},
	{
		number: "04",
		kicker: "AI Governance",
		title: "Connect policy to ownership.",
		body: "Tie requirements to the systems, controls, and people responsible for them.",
	},
];

const architectureLayers = [
	{
		label: "Users & Teams",
		detail: "Employees · Developers · Security",
	},
	{
		label: "AI Applications",
		detail: "Copilots · Agents · Internal Apps",
	},
	{
		label: "ApotheonAI Security Layer",
		detail: "Visibility · Detection · Protection · Governance",
		highlight: true,
	},
	{
		label: "Models & Services",
		detail: "Foundation Models · APIs · Enterprise Data",
	},
];
---

<BaseLayout title="Platform | ApotheonAI">
	<main class="platform-page">
		<!-- Hero -->
		<section class="relative overflow-hidden border-b border-white/10">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_78%_38%,rgba(197,157,86,0.14),transparent_30%)]"
				aria-hidden="true"
			>
			</div>

			<div
				class="container-page relative grid min-h-[82vh] items-center gap-16 py-24 sm:py-28 lg:grid-cols-[1.02fr_0.98fr] lg:gap-14 lg:py-32"
			>
				<div class="relative z-10 max-w-3xl">
					<p class="section-kicker">The ApotheonAI Platform</p>

					<h1
						class="platform-hero-title mt-6 max-w-3xl font-serif text-5xl font-medium leading-[0.95] tracking-[-0.035em] text-cream sm:text-6xl lg:text-7xl xl:text-8xl"
					>
						Security for the
						<span class="block text-mist">full AI lifecycle.</span>
					</h1>

					<p
						class="mt-8 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						ApotheonAI is a fictional AI security brand I designed as a
						portfolio project. The platform page explores one simple idea: a
						security layer between the people using AI and the models, data,
						applications, and services behind it.
					</p>

					<div class="mt-9 flex flex-wrap gap-4">
						<a href="#capabilities" class="btn-gold btn-gold-lg">
							Explore Capabilities
						</a>
					</div>
				</div>

				<!-- Technical platform visual -->
				<div
					class="platform-orbit relative mx-auto w-full max-w-[38rem]"
					aria-hidden="true"
				>
					<div class="orbit-glow"></div>
					<div class="orbit-ring orbit-ring-1"></div>
					<div class="orbit-ring orbit-ring-2"></div>
					<div class="orbit-axis orbit-axis-x"></div>
					<div class="orbit-axis orbit-axis-y"></div>

					<div class="orbit-core">
						<span class="orbit-mark">A</span>
						<div>
							<p>APOTHEON</p>
							<span>SECURITY LAYER</span>
						</div>
					</div>

					<div class="orbit-node orbit-node-1">
						<span>01</span>
						<strong>Models</strong>
					</div>
					<div class="orbit-node orbit-node-2">
						<span>02</span>
						<strong>Agents</strong>
					</div>
					<div class="orbit-node orbit-node-3">
						<span>03</span>
						<strong>Data</strong>
					</div>
					<div class="orbit-node orbit-node-4">
						<span>04</span>
						<strong>Apps</strong>
					</div>

					<p class="orbit-caption">OBSERVE · PROTECT · GOVERN</p>
				</div>
			</div>
		</section>

		<!-- Capabilities -->
		<section id="capabilities" class="border-b border-white/10">
			<div class="container-page py-28 sm:py-32 lg:py-36">
				<div
					class="grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-24"
				>
					<div>
						<p class="section-kicker">Platform Concept</p>
						<h2
							class="mt-5 max-w-2xl font-serif text-4xl font-medium leading-tight tracking-tight text-cream sm:text-5xl lg:text-6xl"
						>
							Four ideas. One clear product story.
						</h2>
						<p
							class="mt-7 max-w-xl font-sans text-base leading-relaxed text-mist sm:text-lg"
						>
							The page keeps the product concept intentionally simple so the
							design, hierarchy, and interactions do the work.
						</p>

						<div class="mt-14 border-t border-white/10">
							{
								capabilities.map((capability) => (
									<article class="border-b border-white/10 py-9 sm:py-10">
										<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
											<span class="font-sans text-xs font-semibold tracking-[0.18em] text-[#c59d56]">
												{capability.number}
											</span>
											<p class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-mist/70">
												{capability.kicker}
											</p>
										</div>

										<h3 class="mt-4 font-serif text-2xl font-medium leading-tight tracking-tight text-cream sm:text-3xl">
											{capability.title}
										</h3>

										<p class="mt-4 max-w-xl font-sans text-sm leading-relaxed text-mist sm:text-base">
											{capability.body}
										</p>
									</article>
								))
							}
						</div>
					</div>

					<div class="capability-visual" aria-hidden="true">
						<div class="visual-header">
							<p>Environment Map</p>
							<span>CONCEPT VIEW</span>
						</div>

						<div class="visual-body">
							<p class="visual-title">One view across the AI estate</p>

							<div class="visual-grid">
								{
									["Models", "Agents", "Apps", "APIs"].map((tag, tagIndex) => (
										<div class="visual-tile">
											<div class="flex items-center justify-between gap-3">
												<span class="visual-index">
													{String(tagIndex + 1).padStart(2, "0")}
												</span>
												<span class="visual-status" />
											</div>
											<strong>{tag}</strong>
											<div class="visual-line">
												<span style={`width:${58 + tagIndex * 9}%`} />
											</div>
										</div>
									))
								}
							</div>

							<div class="visual-footer">
								<span>Signal</span>
								<div>
									<>
										<i></i>
										<i></i>
										<i></i>
										<i></i>
										<i></i>
									</>
								</div>
								<strong>Protected</strong>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Architecture -->
		<section
			class="relative overflow-hidden border-b border-white/10 py-28 sm:py-32 lg:py-36"
		>
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(197,157,86,0.08),transparent_32%)]"
				aria-hidden="true"
			>
			</div>

			<div class="container-page relative">
				<div class="grid gap-16 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
					<div>
						<p class="section-kicker">Platform Architecture</p>
						<h2
							class="mt-5 max-w-xl font-serif text-4xl font-medium leading-tight tracking-tight text-cream sm:text-5xl"
						>
							A simple architecture for the concept.
						</h2>
						<p
							class="mt-6 max-w-xl font-sans text-base leading-relaxed text-mist sm:text-lg"
						>
							The architecture places the security layer between AI applications
							and the models, services, and enterprise data behind them. That
							position creates a common point for observing activity and
							applying controls without changing how every individual tool is
							built.
						</p>
					</div>

					<div class="architecture-stack">
						{
							architectureLayers.map((layer, index) => (
								<>
									<div
										class:list={[
											"architecture-layer",
											layer.highlight && "architecture-layer-highlight",
										]}
									>
										<div>
											<span>{String(index + 1).padStart(2, "0")}</span>
											<strong>{layer.label}</strong>
										</div>
										<p>{layer.detail}</p>
									</div>
									{index < architectureLayers.length - 1 && (
										<div class="architecture-connector" aria-hidden="true">
											<span />
										</div>
									)}
								</>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="relative overflow-hidden py-28 sm:py-32 lg:py-36">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_100%,rgba(197,157,86,0.12),transparent_38%)]"
				aria-hidden="true"
			>
			</div>

			<div class="container-page relative text-center">
				<div class="mx-auto max-w-4xl">
					<p class="section-kicker">Behind the Build</p>
					<h2
						class="mt-6 font-serif text-4xl font-medium leading-tight tracking-tight text-cream sm:text-5xl lg:text-6xl"
					>
						Interested in the process?
					</h2>
					<p
						class="mx-auto mt-6 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						I wrote about the design and development process, the tools I used,
						and what I learned while building the project.
					</p>

					<div class="mt-9 flex flex-wrap justify-center gap-4">
						<a href="/blog" class="btn-gold btn-gold-lg">Read the Build Story</a
						>
					</div>

					<p
						class="mx-auto mt-10 max-w-2xl border-t border-white/10 pt-6 font-sans text-xs leading-relaxed text-mist/75"
					>
						ApotheonAI is a fictional portfolio project.
					</p>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.platform-page {
		width: 100%;
		max-width: 100%;
		overflow-x: clip;
	}

	.platform-page .container-page,
	.platform-page .container-page > *,
	.platform-page [class*="grid"] > *,
	.capability-copy,
	.capability-visual,
	.architecture-stack,
	.architecture-layer,
	.visual-header > *,
	.visual-footer > * {
		min-width: 0;
		max-width: 100%;
	}

	.platform-page :is(h1, h2, h3, p, li, strong, a, span) {
		overflow-wrap: break-word;
	}

	.platform-hero-title {
		text-wrap: balance;
	}

	.platform-orbit {
		aspect-ratio: 1 / 1;
		min-height: 30rem;
	}

	.orbit-glow {
		position: absolute;
		inset: 18%;
		border-radius: 9999px;
		background: rgba(197, 157, 86, 0.08);
		filter: blur(42px);
	}

	.orbit-ring {
		position: absolute;
		left: 50%;
		top: 50%;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		transform: translate(-50%, -50%);
	}

	.orbit-ring-1 {
		width: 72%;
		height: 72%;
	}

	.orbit-ring-2 {
		width: 46%;
		height: 46%;
		border-color: rgba(197, 157, 86, 0.25);
	}

	.orbit-axis {
		position: absolute;
		left: 50%;
		top: 50%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.1),
			transparent
		);
		transform: translate(-50%, -50%);
	}

	.orbit-axis-x {
		width: 86%;
		height: 1px;
	}

	.orbit-axis-y {
		width: 1px;
		height: 86%;
		background: linear-gradient(
			180deg,
			transparent,
			rgba(255, 255, 255, 0.1),
			transparent
		);
	}

	.orbit-core {
		position: absolute;
		left: 50%;
		top: 50%;
		display: flex;
		width: 12.5rem;
		align-items: center;
		gap: 0.9rem;
		border: 1px solid rgba(197, 157, 86, 0.34);
		background: #0c0c0f;
		padding: 1rem 1.1rem;
		transform: translate(-50%, -50%);
		box-shadow: 0 0 45px rgba(197, 157, 86, 0.09);
	}

	.orbit-mark {
		display: grid;
		width: 2.45rem;
		height: 2.45rem;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid rgba(197, 157, 86, 0.45);
		color: #c59d56;
		font-family: var(--font-cane);
		font-size: 1.2rem;
	}

	.orbit-core p {
		margin: 0;
		color: #f2eadc;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.orbit-core div span {
		display: block;
		margin-top: 0.2rem;
		color: rgba(210, 207, 199, 0.62);
		font-family: var(--font-sans);
		font-size: 0.55rem;
		letter-spacing: 0.18em;
	}

	.orbit-node {
		position: absolute;
		min-width: 7.5rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(9, 9, 11, 0.92);
		padding: 0.8rem 0.9rem;
	}

	.orbit-node span {
		display: block;
		color: #c59d56;
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.orbit-node strong {
		display: block;
		margin-top: 0.35rem;
		color: #f2eadc;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.orbit-node-1 {
		left: 4%;
		top: 28%;
	}

	.orbit-node-2 {
		right: 5%;
		top: 20%;
	}

	.orbit-node-3 {
		left: 8%;
		bottom: 20%;
	}

	.orbit-node-4 {
		right: 3%;
		bottom: 27%;
	}

	.orbit-caption {
		position: absolute;
		bottom: 5%;
		left: 50%;
		margin: 0;
		transform: translateX(-50%);
		white-space: nowrap;
		color: rgba(197, 157, 86, 0.75);
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.22em;
	}

	.capability-visual {
		min-width: 0;
	}

	.capability-visual {
		align-self: center;
		border: 1px solid rgba(255, 255, 255, 0.11);
		background:
			linear-gradient(rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0.018)),
			#09090b;
	}

	.visual-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0.9rem 1rem;
	}

	.visual-header p,
	.visual-header span {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.visual-header p {
		color: rgba(242, 234, 220, 0.82);
	}

	.visual-header span {
		color: #c59d56;
	}

	.visual-body {
		padding: 1.4rem;
	}

	.visual-title {
		max-width: 22rem;
		margin: 0;
		color: #f2eadc;
		font-family: var(--font-serif);
		font-size: 1.5rem;
		line-height: 1.2;
	}

	.visual-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
		margin-top: 1.4rem;
	}

	.visual-tile {
		min-height: 7.4rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0.85rem;
	}

	.visual-index {
		color: rgba(197, 157, 86, 0.8);
		font-family: var(--font-sans);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.visual-status {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: #c59d56;
		box-shadow: 0 0 12px rgba(197, 157, 86, 0.35);
	}

	.visual-tile strong {
		display: block;
		margin-top: 1.15rem;
		color: rgba(242, 234, 220, 0.9);
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.visual-line {
		height: 2px;
		margin-top: 0.8rem;
		background: rgba(255, 255, 255, 0.07);
	}

	.visual-line span {
		display: block;
		height: 100%;
		background: rgba(197, 157, 86, 0.65);
	}

	.visual-footer {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: 0.9rem;
		color: rgba(210, 207, 199, 0.6);
		font-family: var(--font-sans);
		font-size: 0.6rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.visual-footer div {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.22rem;
		height: 1rem;
	}

	.visual-footer i {
		display: block;
		width: 2px;
		background: rgba(197, 157, 86, 0.65);
	}

	.visual-footer i:nth-child(1) {
		height: 32%;
	}
	.visual-footer i:nth-child(2) {
		height: 70%;
	}
	.visual-footer i:nth-child(3) {
		height: 48%;
	}
	.visual-footer i:nth-child(4) {
		height: 88%;
	}
	.visual-footer i:nth-child(5) {
		height: 58%;
	}

	.visual-footer strong {
		color: #c59d56;
		font-size: 0.6rem;
	}

	.architecture-stack {
		display: flex;
		width: 100%;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
	}

	.architecture-layer {
		display: grid;
		width: 100%;
		min-width: 0;
		gap: 0.65rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(9, 9, 11, 0.82);
		padding: 1.1rem 1.25rem;
	}

	.architecture-layer > div {
		display: flex;
		min-width: 0;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.architecture-layer span {
		color: #c59d56;
		font-family: var(--font-sans);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.architecture-layer strong {
		min-width: 0;
		overflow-wrap: anywhere;
		color: #f2eadc;
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 500;
	}

	.architecture-layer p {
		min-width: 0;
		margin: 0;
		overflow-wrap: anywhere;
		color: rgba(210, 207, 199, 0.66);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.architecture-layer-highlight {
		border-color: rgba(197, 157, 86, 0.48);
		background: rgba(197, 157, 86, 0.055);
		box-shadow: inset 0 0 0 1px rgba(197, 157, 86, 0.05);
	}

	.architecture-connector {
		display: grid;
		height: 2rem;
		place-items: center;
	}

	.architecture-connector span {
		display: block;
		width: 1px;
		height: 100%;
		background: linear-gradient(
			180deg,
			rgba(197, 157, 86, 0.15),
			rgba(197, 157, 86, 0.7),
			rgba(197, 157, 86, 0.15)
		);
	}

	@media (max-width: 767px) {
		.platform-hero-title {
			font-size: clamp(2.7rem, 12vw, 3.75rem);
			line-height: 0.98;
		}

		.platform-orbit {
			width: min(100%, 22rem);
			min-height: 0;
			aspect-ratio: 1 / 1;
		}

		.orbit-ring-1 {
			width: 76%;
			height: 76%;
		}

		.orbit-ring-2 {
			width: 48%;
			height: 48%;
		}

		.orbit-axis-x {
			width: 82%;
		}

		.orbit-axis-y {
			height: 82%;
		}

		.orbit-core {
			width: clamp(8.7rem, 48vw, 10.25rem);
			max-width: 54%;
			gap: 0.55rem;
			padding: 0.65rem 0.7rem;
		}

		.orbit-mark {
			width: 2rem;
			height: 2rem;
			font-size: 1rem;
		}

		.orbit-core p {
			font-size: clamp(0.53rem, 2.4vw, 0.66rem);
			letter-spacing: 0.11em;
		}

		.orbit-core div span {
			font-size: clamp(0.42rem, 1.9vw, 0.5rem);
			letter-spacing: 0.1em;
		}

		.orbit-node {
			width: clamp(4.7rem, 27vw, 5.6rem);
			min-width: 0;
			max-width: 30%;
			padding: 0.52rem 0.55rem;
		}

		.orbit-node span {
