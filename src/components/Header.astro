---
const links = [
  { href: "#platform", label: "Platform" },
  { href: "#solutions", label: "Solutions" },
  { href: "#insights", label: "Insights" },
  { href: "/about", label: "Company" },
];
---

<header class="relative z-30 shrink-0">
  <nav
    class="container-page flex flex-wrap items-center justify-between py-5 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:py-7"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2.5 lg:justify-self-start" aria-label="ApotheonAI home">
      <span class="logo-gold h-8 w-5 sm:h-9 sm:w-[1.35rem]" aria-hidden="true"></span>
      <span class="font-serif text-lg tracking-tight text-gold sm:text-xl">ApotheonAI</span>
    </a>

    <button
      type="button"
      class="hs-collapse-toggle relative flex size-9 items-center justify-center rounded-md text-cream lg:hidden hover:text-gold"
      id="hs-header-collapse"
      aria-expanded="false"
      aria-controls="hs-header-collapse-nav"
      aria-label="Toggle navigation"
      data-hs-collapse="#hs-header-collapse-nav"
    >
      <svg class="hs-collapse-open:hidden size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" x2="21" y1="6" y2="6"></line>
        <line x1="3" x2="21" y1="12" y2="12"></line>
        <line x1="3" x2="21" y1="18" y2="18"></line>
      </svg>
      <svg class="hs-collapse-open:block hidden size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>

    <div
      id="hs-header-collapse-nav"
      class="hs-collapse hidden w-full basis-full overflow-hidden transition-[height] duration-300 lg:block lg:w-auto lg:basis-auto lg:justify-self-center"
      aria-labelledby="hs-header-collapse"
    >
      <div class="flex flex-col gap-4 py-6 lg:flex-row lg:items-center lg:gap-10 lg:py-0">
        {links.map((link) => (
          <a class="nav-link" href={link.href}>{link.label}</a>
        ))}
        <a class="btn-gold btn-gold-sm mt-2 w-fit lg:hidden" href="#platform">Explore Platform</a>
      </div>
    </div>

    <a class="btn-gold btn-gold-sm hidden lg:inline-flex lg:justify-self-end" href="#platform">Explore Platform</a>
  </nav>
</header>
