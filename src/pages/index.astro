---
import { sanityClient } from "sanity:client";
import BlogCard from "../components/BlogCard.astro";
import Hero from "../components/Hero.astro";
import HomeSection from "../components/HomeSection.astro";
import TextCard from "../components/TextCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const ASCENSION_FILL_DURATION = 0.64;
const ASCENSION_FILL_STAGGER = 0.18;

const capabilities = [
	{
		title: "AI Visibility",
		body: "Discover how AI tools, models, and services are being used across your organization and bring fragmented activity into a clearer operational view.",
		className: "capability-card capability-card-wide",
	},
	{
		title: "AI Threat Detection",
		body: "Identify suspicious activity, risky interactions, and unexpected behavior across AI-powered workflows before they become larger security problems.",
		className: "capability-card",
	},
	{
		title: "Prompt Protection",
		body: "Reduce exposure to unsafe prompts, sensitive data leakage, and malicious interactions across generative AI experiences.",
		className: "capability-card",
	},
	{
		title: "AI Governance",
		body: "Translate policies into practical controls that help security, risk, and engineering teams adopt AI responsibly.",
		className: "capability-card capability-card-wide",
	},
];

const principles = [
	{
		number: "01",
		title: "See the Full Picture",
		body: "Bring AI activity into a shared view so teams can understand what is being used, where it is being used, and how it affects the organization.",
	},
	{
		number: "02",
		title: "Protect What Matters",
		body: "Apply practical security controls around AI workflows, sensitive information, and high-risk interactions.",
	},
	{
		number: "03",
		title: "Enable Responsible Growth",
		body: "Give teams the confidence to explore new AI capabilities while maintaining governance and accountability.",
	},
];

const path = [
	{
		number: "01",
		title: "Discover",
		body: "Understand where AI is being used.",
	},
	{
		number: "02",
		title: "Protect",
		body: "Secure interactions, workflows, models, and data.",
	},
	{
		number: "03",
		title: "Govern",
		body: "Establish consistent controls as AI adoption scales.",
	},
	{
		number: "04",
		title: "Ascend",
		body: "Move forward with confidence, clarity, and control.",
		highlight: true,
	},
];

type BlogPost = {
	_id: string;
	title: string;
	slug: {
		current: string;
	};
	excerpt?: string;
	publishedAt?: string;
	authorName?: string;
	authorProfilePictureUrl?: string;
	headerImageUrl?: string;
	headerImageAlt?: string;
};

const recentPosts = await sanityClient.fetch<BlogPost[]>(`
	*[_type == "post" && defined(slug.current)]
	| order(publishedAt desc, _createdAt desc)[0...3] {
		_id,
		title,
		slug,
		excerpt,
		publishedAt,
		"authorName": author->name,
		"authorProfilePictureUrl": author->profilePicture.asset->url,
		"headerImageUrl": headerImage.asset->url,
		"headerImageAlt": headerImage.alt
	}
`);
---

<BaseLayout title="ApotheonAI | Ascend to the divine">
	<Hero />

	<HomeSection
		id="platform"
		kicker="Platform"
		heading="Bring order to your AI domain."
	>
		<div class="platform-intro mt-10">
			<div
				class="max-w-2xl space-y-5 font-sans text-base leading-relaxed text-mist sm:text-lg"
			>
				<p>
					AI adoption is expanding across tools, teams, and workflows. As
					organizations move faster, understanding where AI is being used and
					what risks come with it becomes increasingly difficult.
				</p>

				<p>
					ApotheonAI brings AI activity into a clearer operational view, helping
					security and engineering teams understand how models, applications,
					and services interact across the organization.
				</p>

				<p>
					From visibility and threat detection to prompt protection and
					governance, the platform is designed to help organizations advance AI
					without giving up control.
				</p>

				<a href="/platform" class="btn-gold btn-gold-lg mt-3">
					Explore the Platform
				</a>
			</div>

			<div class="security-map" aria-hidden="true">
				<div class="security-map-ring security-map-ring-outer"></div>
				<div class="security-map-ring security-map-ring-inner"></div>
				<div class="security-map-axis security-map-axis-x"></div>
				<div class="security-map-axis security-map-axis-y"></div>

				<div class="security-map-core">
					<span class="security-map-mark">A</span>
					<span>APOTHEON</span>
				</div>

				<span class="security-map-node security-map-node-models">Models</span>
				<span class="security-map-node security-map-node-agents">Agents</span>
				<span class="security-map-node security-map-node-data">Data</span>
				<span class="security-map-node security-map-node-apps"
					>Applications</span
				>
				<span class="security-map-caption">Observe · Protect · Govern</span>
			</div>
		</div>
	</HomeSection>

	<HomeSection
		id="capabilities"
		kicker="Capabilities"
		heading="Command the full AI lifecycle."
	>
		<div class="capability-grid mt-12 max-w-6xl">
			{
				capabilities.map((capability) => (
					<TextCard class={capability.className}>
						<span class="capability-corner" aria-hidden="true" />
						<h3 class="font-serif text-xl font-medium tracking-tight text-cream sm:text-2xl">
							{capability.title}
						</h3>
						<p class="mt-3 max-w-xl font-sans text-base leading-relaxed text-mist sm:text-lg">
							{capability.body}
						</p>
					</TextCard>
				))
			}
		</div>

		<a href="/platform" class="btn-gold btn-gold-lg mt-12">
			Explore all capabilities
		</a>
	</HomeSection>

	<section class="home-manifesto" aria-labelledby="manifesto-title">
		<div class="container-page">
			<div class="manifesto-rule" aria-hidden="true">
				<span></span>
				<i></i>
				<span></span>
			</div>
			<h2 id="manifesto-title" class="manifesto-title">
				<span>AI is moving</span>
				<span>faster than</span>
				<span>governance.</span>
			</h2>
			<p class="manifesto-subtitle">
				<span class="manifesto-gold">ApotheonAI</span> closes the gap.
			</p>
		</div>
	</section>

	<HomeSection
		id="why"
		kicker="Why ApotheonAI"
		heading="Rise without losing control."
	>
		<p
			class="mt-8 max-w-3xl font-sans text-base leading-relaxed text-mist sm:text-lg"
		>
			AI maturity should not mean choosing between innovation and security.
			ApotheonAI is built around three principles that help organizations
			advance responsibly.
		</p>

		<div class="principle-rail mt-14 max-w-6xl">
			{
				principles.map((principle) => (
					<article class="principle-item">
						<p class="principle-number">{principle.number}</p>
						<div class="principle-rule" aria-hidden="true" />
						<h3 class="font-serif text-2xl font-medium tracking-tight text-cream sm:text-3xl">
							{principle.title}
						</h3>
						<p class="mt-4 font-sans text-sm leading-relaxed text-mist sm:text-base">
							{principle.body}
						</p>
					</article>
				))
			}
		</div>
	</HomeSection>

	<HomeSection
		id="path"
		kicker="From Adoption to Control"
		heading="Forge a clearer path to trusted AI."
	>
		<div
			class="ascension-path mt-14 w-full max-w-none"
			data-ascension-path
			data-fill-duration={ASCENSION_FILL_DURATION}
			data-fill-stagger={ASCENSION_FILL_STAGGER}
		>
			<div class="ascension-line" data-ascension-line aria-hidden="true"></div>
			{
				path.map((step) => (
					<article
						class:list={[
							"ascension-step",
							step.highlight && "ascension-step-highlight",
						]}
					>
						<div
							class:list={[
								"ascension-node",
								step.highlight && "ascension-node-highlight",
							]}
							data-ascension-node
							aria-hidden="true"
						/>
						<p
							class:list={[
								"ascension-number",
								step.highlight && "ascension-number-highlight",
							]}
						>
							{step.number}
						</p>
						<h3
							class:list={[
								"mt-3 font-serif text-2xl font-medium tracking-tight text-cream sm:text-3xl",
								step.highlight && "ascension-title-highlight",
							]}
						>
							{step.title}
						</h3>
						<p
							class:list={[
								"mt-3 max-w-xs font-sans text-base leading-relaxed text-mist",
								step.highlight && "ascension-body-highlight",
							]}
						>
							{step.body}
						</p>
					</article>
				))
			}
		</div>
	</HomeSection>

	<section id="recent-articles" class="border-y border-white/10">
		<div class="container-page py-28 sm:py-32 lg:py-36">
			<div
				class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
			>
				<div>
					<p class="section-kicker">Recent Articles</p>
					<h2
						class="mt-5 max-w-3xl font-serif text-4xl font-medium leading-tight tracking-tight text-cream sm:text-5xl"
					>
						Notes from the build.
					</h2>
					<p
						class="mt-6 max-w-2xl font-sans text-base leading-relaxed text-mist sm:text-lg"
					>
						Recent posts about the development process, tools, and ideas behind
						ApotheonAI.
					</p>
				</div>

				<a
					href="/blog"
					class="font-sans text-sm font-semibold text-[#c59d56] underline-offset-4 transition hover:text-cream hover:underline"
				>
					View all articles →
				</a>
			</div>

			{
				recentPosts.length > 0 ? (
					<div class="mt-14 grid gap-x-8 gap-y-10 md:grid-cols-2 xl:grid-cols-3 xl:gap-x-10">
						{recentPosts.map((post, index) => (
							<BlogCard
								title={post.title}
								slug={post.slug.current}
								excerpt={post.excerpt}
								publishedAt={post.publishedAt}
								authorName={post.authorName}
								authorProfilePictureUrl={post.authorProfilePictureUrl}
								headerImageUrl={post.headerImageUrl}
								headerImageAlt={post.headerImageAlt}
								priority={index === 0}
							/>
						))}
					</div>
				) : (
					<div class="mt-14 border-y border-white/10 py-12">
						<p class="font-sans text-base text-mist">
							No articles have been published yet.
						</p>
					</div>
				)
			}
		</div>
	</section>

	<section id="contact" class="home-final-cta">
		<div class="container-page">
			<div class="home-final-cta-inner">
				<p class="section-kicker">The Next Level</p>
				<h2>Elevate the standard of AI security.</h2>
				<p>
					Build greater visibility, stronger protection, and responsible
					governance into the foundation of your AI environment.
				</p>
				<div class="mt-9 flex flex-wrap justify-center gap-4">
					<a href="/platform" class="btn-gold btn-gold-lg"
						>Explore the Platform</a
					>
					<a href="/contact" class="home-secondary-cta">Talk to Us</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style is:global>
	/* Match the roomier vertical rhythm used on the Platform page. */
	#platform,
	#capabilities,
	#why,
	#path,
	.home-manifesto,
	.home-final-cta {
		padding-top: 7rem;
		padding-bottom: 7rem;
	}

	/* Keep the path rail centered through every hollow diamond. */
	#path .ascension-path {
		position: relative;
	}

	#path .ascension-line {
		position: absolute;
		z-index: 0;
		display: block;
		height: 1px;
		margin: 0;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(197, 157, 86, 0.22),
			rgba(197, 157, 86, 0.62),
			rgba(197, 157, 86, 0.22)
		);
	}

	#path .ascension-step {
		position: relative;
		z-index: 1;
	}

	#path .ascension-step-highlight {
		position: relative;
	}

	#path .ascension-step-highlight::before {
		content: "";
		position: absolute;
		left: -1.75rem;
		top: 50%;
		z-index: -1;
		width: min(32rem, calc(100% + 5rem));
		height: 12.5rem;
		border-radius: 50%;
		background: radial-gradient(
			ellipse at center,
			rgba(197, 157, 86, 0.28) 0%,
			rgba(197, 157, 86, 0.15) 34%,
			rgba(197, 157, 86, 0.065) 58%,
			transparent 78%
		);
		filter: blur(11px);
		transform: translateY(-50%);
		pointer-events: none;
	}

	#path .ascension-node-highlight {
		border-color: rgba(197, 157, 86, 0.9);
		box-shadow:
			0 0 12px rgba(197, 157, 86, 0.28),
			0 0 28px rgba(197, 157, 86, 0.14);
	}

	#path .ascension-number-highlight,
	#path .ascension-title-highlight {
		color: #c59d56;
		text-shadow: 0 0 18px rgba(197, 157, 86, 0.16);
	}

	#path .ascension-body-highlight {
		color: rgba(242, 234, 220, 0.82);
	}

	/* Keep the path as one continuous rail instead of allowing steps to wrap. */
	@media (max-width: 1023px) {
		#path .ascension-path {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 4.5rem;
		}

		#path .ascension-step {
			width: 100%;
			min-width: 0;
		}

		#path .ascension-step-highlight::before {
			left: -1rem;
			width: min(26rem, calc(100% + 2rem));
			height: 10rem;
		}
	}

	/* Tablet needs its own rail gutter so the tracker never crosses the copy. */
	@media (min-width: 640px) and (max-width: 1023px) {
		#path .ascension-path {
			--ascension-rail-gutter: clamp(4.75rem, 8vw, 6rem);
			padding-left: var(--ascension-rail-gutter);
		}

		#path .ascension-step {
			position: relative;
		}

		#path .ascension-node {
			position: absolute;
			left: calc(var(--ascension-rail-gutter) * -0.72);
			top: 0.1rem;
			margin: 0;
		}
	}

	@media (min-width: 1024px) {
		#path .ascension-path {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			align-items: start;
			column-gap: clamp(2rem, 3vw, 4rem);
		}

		#path .ascension-step {
			width: 100%;
			min-width: 0;
		}
	}

	/* Keep the first section closer to the hero so the transition feels tighter. */
	#platform {
		padding-top: 5rem;
	}

	@media (min-width: 640px) {
		#platform,
		#capabilities,
		#why,
		#path,
		.home-manifesto,
		.home-final-cta {
			padding-top: 8rem;
			padding-bottom: 8rem;
		}

		#platform {
			padding-top: 6rem;
		}
	}

	@media (min-width: 1024px) {
		#platform,
		#capabilities,
		#why,
		#path,
		.home-manifesto,
		.home-final-cta {
			padding-top: 9rem;
			padding-bottom: 9rem;
		}

		#platform {
			padding-top: 7rem;
		}
	}
</style>
<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	let ascensionTrigger: ScrollTrigger | null = null;

	type NodePosition = {
		x: number;
		y: number;
	};

	function initAscensionProgress() {
		ascensionTrigger?.kill();
		ascensionTrigger = null;

		const path = document.querySelector<HTMLElement>("[data-ascension-path]");
		const line = path?.querySelector<HTMLElement>("[data-ascension-line]");
		const nodes = path
			? Array.from(path.querySelectorAll<HTMLElement>("[data-ascension-node]"))
			: [];

		if (!path || !line || nodes.length < 2) {
			return;
		}

		const fillDuration = Number(path.dataset.fillDuration) || 0.64;
		const fillStagger = Number(path.dataset.fillStagger) || 0.08;

		let positions: NodePosition[] = [];
		let filledCount = 0;

		const measure = () => {
			const pathRect = path.getBoundingClientRect();

			positions = nodes.map((node) => {
				const rect = node.getBoundingClientRect();

				return {
					x: rect.left - pathRect.left + rect.width / 2,
					y: rect.top - pathRect.top + rect.height / 2,
				};
			});

			const first = positions[0];
			const last = positions[positions.length - 1];
			const deltaX = last.x - first.x;
			const deltaY = last.y - first.y;
			const distance = Math.hypot(deltaX, deltaY);
			const angle = Math.atan2(deltaY, deltaX) * (180 / Math.PI);

			Object.assign(line.style, {
				left: `${first.x}px`,
				top: `${first.y}px`,
				right: "auto",
				bottom: "auto",
				width: `${distance}px`,
				height: "1px",
				transform: `rotate(${angle}deg)`,
				transformOrigin: "0 50%",
			});
		};

		const setNodeFilled = (
			node: HTMLElement,
			filled: boolean,
			animate: boolean,
			delay = 0,
		) => {
			gsap.killTweensOf(node);

			const vars = filled
				? {
						backgroundColor: "#c59d56",
						borderColor: "#c59d56",
						boxShadow:
							"0 0 14px rgba(197, 157, 86, 0.42), 0 0 28px rgba(197, 157, 86, 0.16)",
					}
				: {
						backgroundColor: "rgba(9, 9, 11, 0)",
						borderColor: "rgba(197, 157, 86, 0.72)",
						boxShadow: "0 0 0 rgba(197, 157, 86, 0)",
					};

			if (!animate) {
				gsap.set(node, vars);
				return;
			}

			gsap.to(node, {
				...vars,
				duration: fillDuration,
				delay,
				ease: "power2.out",
				overwrite: true,
			});
		};

		const updateFilledNodes = (progress: number, animate: boolean) => {
			const clamped = Math.min(1, Math.max(0, progress));
			const nextFilledCount = Math.min(
				nodes.length,
				Math.max(0, Math.floor(clamped * nodes.length) + (clamped > 0 ? 1 : 0)),
			);

			if (nextFilledCount === filledCount) {
				return;
			}

			if (!animate) {
				nodes.forEach((node, index) => {
					setNodeFilled(node, index < nextFilledCount, false);
				});
				filledCount = nextFilledCount;
				return;
			}

			if (nextFilledCount > filledCount) {
				for (let index = filledCount; index < nextFilledCount; index += 1) {
					setNodeFilled(
						nodes[index],
						true,
						true,
						(index - filledCount) * fillStagger,
					);
				}
			} else {
				for (
					let index = filledCount - 1;
					index >= nextFilledCount;
					index -= 1
				) {
					setNodeFilled(
						nodes[index],
						false,
						true,
						(filledCount - 1 - index) * fillStagger,
					);
				}
			}

			filledCount = nextFilledCount;
		};

		measure();
		updateFilledNodes(0, false);

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			nodes.forEach((node) => setNodeFilled(node, true, false));
			return;
		}

		ascensionTrigger = ScrollTrigger.create({
			trigger: path,
			start: "top 68%",
			end: "bottom 58%",
			invalidateOnRefresh: true,
			onRefreshInit: measure,
			onRefresh: (self) => {
				measure();
				updateFilledNodes(self.progress, false);
			},
			onUpdate: (self) => {
				updateFilledNodes(self.progress, true);
			},
		});
	}

	initAscensionProgress();
	document.addEventListener("astro:page-load", initAscensionProgress);
</script>
