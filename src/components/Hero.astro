---
import { Image } from "astro:assets";
import heroHelmet from "../assets/images/hero-helmet.png";
import DivineFlow from "./DivineFlow";
---

<section class="hero-section" aria-labelledby="hero-heading">
	<div class="hero-stage">
		<div class="hero-flow">
			<DivineFlow
				client:load
				lineCount={7}
				scatterCount={2}
				innerGap={108}
				originY={0.42}
				motion={2}
			/>
		</div>

		<div class="hero-glow"></div>

		<div class="hero-cluster">
			<Image
				class="hero-helmet noselect"
				src={heroHelmet}
				alt="Weathered bronze Spartan helmet"
				loading="eager"
				fetchpriority="high"
				draggable={false}
			/>

			<h1 id="hero-heading" class="hero-title">
				<span class="hero-title-stack">
					<span class="hero-word-ascend hero-metal">ASCEND</span>
					<span class="hero-word-mid hero-metal">TO THE</span>
					<span class="hero-word-divine hero-metal">DIVINE</span>
				</span>
			</h1>
		</div>
	</div>
</section>
