const CX = 50;
const CY = 34;

type Star = {
  x: number;
  y: number;
  r: number;
  spark: boolean;
  delay: string;
};

function pct(n: number) {
  return `${Math.round(n * 100) / 100}%`;
}

function insideHelmet(x: number, y: number, padX = 1.28, padY = 1.12) {
  const nx = (x - CX) / (10.4 * padX);
  const ny = (y - CY) / (36 * padY);
  return nx * nx + ny * ny < 1;
}

function inTitleGap(x: number, y: number) {
  return y > 58 && y < 96 && Math.abs(x - CX) < 16;
}

function crossesHelmet(x1: number, y1: number, x2: number, y2: number) {
  for (let s = 1; s < 6; s++) {
    const t = s / 6;
    if (insideHelmet(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t, 1.18, 1.06)) return true;
  }
  return false;
}

function S(x: number, y: number, r = 2, spark = false, delay = "0s"): Star {
  return { x, y, r, spark, delay };
}

