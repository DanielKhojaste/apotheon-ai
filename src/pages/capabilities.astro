---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ApotheonAI | Capabilities">
	<article class="container-page py-16">
		<div class="max-w-3xl">
			<p class="section-kicker mb-4">Capabilities</p>
			<h1
				class="font-serif text-4xl font-medium tracking-tight text-cream sm:text-5xl"
			>
				Command the full AI lifecycle
			</h1>
			<p class="mt-6 font-sans text-base leading-relaxed text-mist sm:text-lg">
				Explore how ApotheonAI covers visibility, threat detection, prompt
				protection, and governance. This page is a placeholder for the full
				capabilities overview.
			</p>
		</div>
	</article>
</BaseLayout>
