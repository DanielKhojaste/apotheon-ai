const stars: Star[] = [];
const lines: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
const edgeKeys = new Set<string>();

function addLine(x1: number, y1: number, x2: number, y2: number) {
  if (x1 === x2 && y1 === y2) return;
  const a = x1 < x2 || (x1 === x2 && y1 <= y2) ? [x1, y1, x2, y2] : [x2, y2, x1, y1];
  const key = a.map((n) => n.toFixed(2)).join(",");
  if (edgeKeys.has(key)) return;
  if (crossesHelmet(x1, y1, x2, y2)) return;
  edgeKeys.add(key);
  lines.push({ x1, y1, x2, y2 });
}

for (const fig of figures) {
  const index: number[] = [];
  for (const star of fig.stars) {
    if (insideHelmet(star.x, star.y) || inTitleGap(star.x, star.y)) {
      index.push(-1);
      continue;
    }
    index.push(stars.length);
    stars.push(star);
  }
  for (const [a, b] of fig.links) {
    if (index[a] < 0 || index[b] < 0) continue;
    const from = stars[index[a]];
    const to = stars[index[b]];
    addLine(from.x, from.y, to.x, to.y);
  }
}

for (const [[x1, y1], [x2, y2]] of bridges) {
  addLine(x1, y1, x2, y2);
}
