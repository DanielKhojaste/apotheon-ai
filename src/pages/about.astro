---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ApotheonAI | About">
  <article class="container-page py-16">
    <div class="max-w-3xl">
    <p class="section-kicker mb-4">Company</p>
    <h1 class="font-serif text-4xl font-medium tracking-tight text-cream sm:text-5xl">
      About ApotheonAI
    </h1>
    <p class="mt-6 font-sans text-base leading-relaxed text-mist sm:text-lg">
      ApotheonAI is a (fictional) enterprise that leverages artificial intelligence to provide
      innovative solutions for various industries. Our mission is to harness the power of AI to
      enhance productivity, streamline processes, and drive growth for businesses worldwide.
    </p>
    </div>
  </article>
</BaseLayout>
